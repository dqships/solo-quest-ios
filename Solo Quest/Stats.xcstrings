    "stat.motivation.charisma": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engage in social quests, conversations, and public speaking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Participa en misiones sociales, conversaciones y oratoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach soziale Quests, starte Gespräche und übe Präsenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance-toi dans des quêtes sociales, des conversations et des prises de parole."
          }
        }
      }
    },
    "stat.motivation.intelligence": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on reading, learning, and problem-solving quests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfócate en misiones de lectura, aprendizaje y resolución de problemas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzentriere dich auf Lesen, Lernen und Problemlösen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise sur la lecture, l’apprentissage et la résolution de problèmes."
          }
        }
      }
    },
    "stat.motivation.luck": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take risks and try random new experiences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma riesgos y prueba nuevas experiencias aleatorias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh kleine Risiken ein und probiere zufällige neue Erfahrungen aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends de petits risques et essaie des expériences nouvelles."
          }
        }
      }
    },
    "stat.motivation.resilience": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push through discomfort and handle difficult situations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera la incomodidad y maneja situaciones difíciles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh durch Unbehagen und meistere schwierige Situationen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traverse l’inconfort et gère les situations difficiles."
          }
        }
      }
    },
    "stat.motivation.stamina": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete long-duration tasks and endurance challenges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa tareas de larga duración y desafíos de resistencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe längere Aufgaben und Ausdauer-Challenges ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine des tâches longues et des défis d’endurance."
          }
        }
      }
    },
    "stat.motivation.strength": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do more physical quests like workouts, walks, or labor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz más misiones físicas como ejercicios, caminatas o trabajo manual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach mehr körperliche Quests wie Workouts, Spaziergänge oder praktische Arbeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais plus de quêtes physiques : entraînements, marches ou efforts concrets."
          }
        }
      }
    },
