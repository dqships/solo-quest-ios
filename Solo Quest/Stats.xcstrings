    "stat.tagline.charisma": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations, connection, presence, and social courage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversaciones, conexión, presencia y coraje social."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespräche, Verbindung, Präsenz und sozialer Mut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations, liens, présence et courage social."
          }
        }
      }
    },
    "stat.tagline.intelligence": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning, reflecting, and thinking more clearly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender, reflexionar y pensar con más claridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen, reflektieren und klarer denken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre, réfléchir et penser plus clairement."
          }
        }
      }
    },
    "stat.tagline.luck": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serendipity, risk, and putting yourself in new situations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Serendipia, riesgo y ponerte en nuevas situaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zufall, Risiko und neue Situationen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasard, prise de risque et nouvelles situations."
          }
        }
      }
    },
    "stat.tagline.resilience": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emotional toughness, facing discomfort, and trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortaleza emocional, enfrentar incomodidad e intentar de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emotionale Stärke, Unbehagen aushalten und wieder versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solidité émotionnelle, inconfort et nouveau départ."
          }
        }
      }
    },
    "stat.tagline.stamina": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance, sticking with things, and longer sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistencia, perseverancia y sesiones más largas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchhalten, dranbleiben und längere Sessions schaffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance, régularité et sessions plus longues."
          }
        }
      }
    },
    "stat.tagline.strength": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Physical power, effort, and moving your body on purpose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poder físico, esfuerzo y mover tu cuerpo intencionalmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körperkraft, Einsatz und bewusste Bewegung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puissance physique, effort et mouvement volontaire."
          }
