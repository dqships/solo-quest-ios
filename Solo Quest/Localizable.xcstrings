          }
        }
      }
    },
    "This deletes quests, stats, goals, preferences, and saved adventure media from Solo Quest. Your account and purchases stay intact. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Quests, Statistiken, Ziele, Einstellungen und gespeicherte Abenteuermedien aus Solo Quest gelöscht. Dein Konto und deine Käufe bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes quests, stats, goals, preferences, and saved adventure media from Solo Quest. Your account and purchases stay intact. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina las misiones, estadísticas, metas, preferencias y archivos de aventura guardados de Solo Quest. Tu cuenta y tus compras se mantienen intactas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime les quêtes, les stats, les objectifs, les préférences et les médias d’aventure enregistrés dans Solo Quest. Ton compte et tes achats restent intacts. Cette action est irréversible."
          }
        }
      }
    },
    "This doesn't erase your journey. It just means your next streak will matter even more." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das löscht deine Reise nicht. Es bedeutet nur, dass deine nächste Serie noch mehr zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This doesn't erase your journey. It just means your next streak will matter even more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no borra tu camino. Solo significa que tu próxima racha importará aún más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça n’efface pas ton aventure. Ça rend juste ta prochaine série encore plus importante."
          }
        }
      }
    },
    "This doesn’t erase your journey. It just means your next streak will matter even more." : {
      "localizations" : {
