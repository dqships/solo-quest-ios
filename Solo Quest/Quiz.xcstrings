    "quiz.luck.shop": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're walking in a new neighborhood. You see an interesting shop you've never noticed. Do you go in?"
