  "strings": {
    "quiz.charisma.elevator": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in an elevator with a stranger. The ride is 10 floors. Do you start a conversation?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en un ascensor con un extraño. El viaje es de 10 pisos. ¿Inicias una conversación?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist mit einer fremden Person im Aufzug. Die Fahrt dauert 10 Stockwerke. Startest du ein Gespräch?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es dans un ascenseur avec une personne inconnue. Il y a 10 étages. Tu lances la conversation ?"
          }
        }
      }
    },
    "quiz.charisma.favor": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to ask a favor from someone you barely know. How do you approach it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas pedirle un favor a alguien que apenas conoces. ¿Cómo lo abordas?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst jemanden, den du kaum kennst, um einen Gefallen bitten. Wie gehst du vor?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dois demander un service à quelqu’un que tu connais à peine. Tu t’y prends comment ?"
          }
        }
      }
    },
