    "quest.friendship-021": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a coworker or classmate you like how they're finding the job or class and share your honest take too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
