      }
    },
    "quest.status-092": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear one slightly elevated piece such as nicer shoes, jewelry, or jacket to a totally normal place and let yourself stand out a little."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una pieza ligeramente elevada como zapatos más bonitos, joyería o chaqueta a un lugar totalmente normal y déjate destacar un poco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage ein etwas erhöhtes Kleidungsstück, beispielsweise schönere Schuhe, Schmuck oder eine Jacke, an einer ganz normalen Stelle und lassen Sie sich ein wenig hervorstechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez une pièce légèrement surélevée, comme des chaussures plus jolies, des bijoux ou une veste, dans un endroit tout à fait normal et laissez-vous démarquer un peu."
          }
        }
      }
    },
    "quest.status-093": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a solo seat at the end of a bar, counter, or bench and sit there for 10 minutes like someone waiting for their crew to arrive—even if no one is coming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un asiento solo al final de una barra, mostrador o banca y siéntate ahí por 10 minutos como alguien esperando a que llegue su grupo—aunque nadie venga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm alleine am Ende einer Bar, Theke oder Bank Platz und sitz dort 10 Minuten lang wie jemand, der auf die Ankunft seiner Crew wartet – auch wenn niemand kommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un siège solo au bout d'un bar, d'un comptoir ou d'un banc et restez assis là pendant 10 minutes comme quelqu'un attendant l'arrivée de son équipe, même si personne ne vient."
          }
        }
      }
    },
    "quest.status-094": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 15 minutes writing a short description of your future high-status self: how you dress, move, talk, and where you spend time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 15 minutos escribiendo una descripción corta de tu yo futuro de alto estatus: cómo te vistes, mueves, hablas, y dónde pasas tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 15 Minuten damit, eine kurze Beschreibung Ihres zukünftigen hochrangigen Selbst zu schreiben: wie Sie sich kleiden, bewegen, sprechen und wo Sie Zeit verbringen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 15 minutes à rédiger une brève description de votre futur moi de haut rang : comment vous vous habillez, bougez, parlez et où vous passez du temps."
          }
        }
      }
    },
    "quest.status-095": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a grocery store or market and build one \"high-status\" snack or meal with fresh ingredients that make you feel taken care of."
          }
        },
        "es": {
