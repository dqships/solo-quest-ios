    },
    "quest.rejection-100": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one week, collect at least 5 rejections or brush-offs and 5 neutral or positive responses, proving to yourself that both can coexist and you are still fine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una semana, colecciona al menos 5 rechazos y 5 respuestas neutrales o positivas, probándote a ti mismo/a que ambos pueden coexistir y que aún estás bien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle in einer Woche mindestens 5 Ablehnungen oder Abweisungen und 5 neutrale oder positive Antworten und beweisen Sie sich selbst, dass beides nebeneinander bestehen kann und es Ihnen immer noch gut geht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En une semaine, récoltez au moins 5 refus ou rejets et 5 réponses neutres ou positives, vous prouvant ainsi que les deux peuvent coexister et que vous allez toujours bien."
          }
        }
      }
    },
