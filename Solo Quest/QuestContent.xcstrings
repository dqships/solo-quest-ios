        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm an einem lokalen Treffen, Kurs oder einer Veranstaltung teil, bei der Sie niemanden kennen, und stell sich mindestens zwei Personen vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez une rencontre, un cours ou un événement local où vous ne connaissez personne et présentez-vous à au moins 2 personnes."
