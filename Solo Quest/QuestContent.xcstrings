    "quest.adventure-013": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into a hotel lobby like you belong there, find a seat, and relax or journal there for at least 15 minutes."
          }
        },
        "es": {
          "stringUnit": {
