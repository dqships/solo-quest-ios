      }
    },
    "quest.adventure-012": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a thrift store and build a full outfit under a budget you set, then wear it out in public the same day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una tienda de segunda mano y arma un atuendo completo con un presupuesto que establezcas, luego úsalo en público el mismo día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in einen Gebrauchtwarenladen und stell sich zu einem von Ihnen festgelegten Budget ein komplettes Outfit zusammen und trage es dann noch am selben Tag in der Öffentlichkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans une friperie et créez une tenue complète avec le budget que vous avez fixé, puis portez-la en public le même jour."
          }
        }
      }
