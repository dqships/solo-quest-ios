      }
    },
    "quest.friendship-008": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a genuine, specific compliment to 3 people you already know, about their work, personality, or growth."
          }
        },
        "es": {
