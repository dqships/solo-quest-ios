        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazieren Sie nachts ohne Kopfhörer durch das Nachtleben oder eine belebte Gegend und nimm einfach die Energie auf, als wären Sie Teil des Hauptgeschehens der Stadt."
          }
        },
        "fr": {
