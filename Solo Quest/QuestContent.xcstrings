            "value": "Geh in ein Einkaufszentrum oder Einkaufszentrum und geh eine ganze Runde, auch in eine Etage, die Sie normalerweise ignorieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
