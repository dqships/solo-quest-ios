    "quest.friendship-001": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text someone you like but haven't talked to in over a month and ask how they've really been, not just 'wyd'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje a alguien que te agrada pero con quien no has hablado en más de un mes y pregúntale cómo ha estado realmente, no solo 'qué haces'."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib jemandem, den Sie mögen, mit dem Sie aber seit über einem Monat nicht gesprochen haben, eine SMS und frag, wie es ihm wirklich geht, nicht nur „Wow“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un SMS à quelqu'un que vous aimez mais à qui vous n'avez pas parlé depuis plus d'un mois et demandez-lui comment il va vraiment, pas seulement « wyd »."
          }
        }
      }
    },
    "quest.friendship-002": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to grab coffee, boba, or tea this week and offer two possible days or times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a tomar café, boba o té esta semana y ofrece dos posibles días u horarios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] diese Woche zu Kaffee, Boba oder Tee ein und bieten Sie zwei mögliche Tage oder Zeiten an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à prendre un café, un boba ou un thé cette semaine et proposez deux jours ou heures possibles."
          }
        }
      }
    },
    "quest.friendship-003": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call a friend instead of texting and stay on the phone for at least 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama a un amigo/a en lugar de enviar mensaje y quédate en el teléfono al menos 10 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruf einen Freund an, anstatt ihm eine SMS zu schreiben, und bleib mindestens 10 Minuten am Telefon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez un ami au lieu d’envoyer des SMS et restez au téléphone pendant au moins 10 minutes."
          }
        }
      }
    },
    "quest.friendship-004": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a voice note to [person] telling them one thing you genuinely appreciate about them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una nota de voz a [person] diciéndole algo que genuinamente aprecias de él/ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende [person] eine Sprachnotiz und sag ihr, was Sie wirklich an ihr schätzen."
          }
