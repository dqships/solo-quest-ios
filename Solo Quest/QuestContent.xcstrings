        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er diese Woche mit Ihnen ein neues Restaurant, Café oder Essenslokal ausprobieren möchte, und vereinbare einen Termin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il souhaite essayer un nouveau restaurant, café ou lieu de restauration avec vous cette semaine et fixez une heure."
          }
        }
