    },
    "quest.adventure-049": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a hill, staircase, or steep slope and walk up it five times at a steady pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra una colina, escalera o pendiente empinada y súbela cinco veces a un ritmo constante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such sich einen Hügel, eine Treppe oder einen steilen Hang und geh diesen fünfmal in gleichmäßigem Tempo hinauf."
          }
