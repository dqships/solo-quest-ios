          }
        }
      }
    },
    "quest.friendship-015": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask [person] a deeper question than usual such as \"What's been on your mind lately?\" and really listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazle a [person] una pregunta más profunda de lo habitual como \"¿Qué ha estado en tu mente últimamente?\" y realmente escucha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell [person] eine tiefergehende Frage als sonst, wie zum Beispiel „Was ging Ihnen in letzter Zeit durch den Kopf?“ und wirklich zuhören."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez à [person] une question plus profonde que d'habitude, comme « Qu'est-ce qui vous vient à l'esprit ces derniers temps ? » et vraiment écouter."
          }
        }
      }
    },
    "quest.friendship-016": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join a local meetup, class, or event where you don't know anyone and introduce yourself to at least 2 people."
          }
        },
        "es": {
