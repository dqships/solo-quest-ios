    },
    "quest.friendship-022": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to come with you to an event you're already going to such as a show, open mic, or meetup."
          }
        },
        "es": {
          "stringUnit": {
