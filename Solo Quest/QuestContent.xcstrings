          "stringUnit": {
            "state": "translated",
            "value": "Go to a different grocery store than usual and walk every aisle one time, noticing items and people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un supermercado diferente al habitual y camina por cada pasillo una vez, notando artículos y personas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in ein anderes Lebensmittelgeschäft als sonst und geh einmal durch jeden Gang, wobei Sie auf Gegenstände und Personen achten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans une épicerie différente de celle d’habitude et parcourez chaque allée une fois, en remarquant les articles et les personnes."
          }
        }
      }
    },
    "quest.adventure-033": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into a shop you'd normally never enter such as a high-end clothing or niche hobby store and explore for 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra a una tienda donde normalmente nunca entrarías como una de ropa de alta gama o hobby especializado y explora por 10 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in ein Geschäft, das Sie normalerweise nie betreten würden, zum Beispiel einen High-End-Bekleidungs- oder Nischen-Hobbyladen, und erkunde ihn 10 Minuten lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez dans un magasin dans lequel vous n'entreriez normalement jamais, comme un magasin de vêtements haut de gamme ou de loisirs spécialisés, et explorez pendant 10 minutes."
          }
        }
      }
    },
    "quest.adventure-034": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a local sports court or field and spend at least 10 minutes shooting hoops, kicking a ball, or practicing a skill."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra una cancha o campo deportivo local y pasa al menos 10 minutos lanzando canastas, pateando un balón o practicando una habilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde einen örtlichen Sportplatz und verbringe mindestens zehn Minuten damit, Körbe zu werfen, einen Ball zu treten oder eine Fertigkeit zu üben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un terrain de sport ou un terrain de sport local et passez au moins 10 minutes à tirer des cerceaux, à taper dans un ballon ou à pratiquer une compétence."
          }
        }
      }
    },
    "quest.adventure-035": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a long walk at night in a safe, well-lit area and pay attention to how your city feels different after dark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un largo paseo de noche en una zona segura y bien iluminada y presta atención a cómo se siente diferente tu ciudad después del anochecer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach nachts einen langen Spaziergang an einem sicheren, gut beleuchteten Ort und achte darauf, wie sich Ihre Stadt nach Einbruch der Dunkelheit anders anfühlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une longue promenade la nuit dans un endroit sûr et bien éclairé et faites attention à la façon dont votre ville se sent différente une fois la nuit tombée."
          }
        }
      }
    },
    "quest.adventure-036": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk across a bridge or overpass you usually only drive and stop in the middle to look around."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruza caminando un puente o paso elevado que normalmente solo conduces y detente en el medio para mirar alrededor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh über eine Brücke oder Überführung, über die Sie normalerweise nur fahren, und bleib in der Mitte stehen, um sich umzusehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traversez un pont ou un viaduc, vous conduisez généralement uniquement et arrêtez-vous au milieu pour regarder autour de vous."
          }
        }
      }
    },
    "quest.adventure-037": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a map and draw a rough 2 mile or 3 km loop near you, then walk or jog the full loop once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un mapa y dibuja un circuito aproximado de 3 km cerca de ti, luego camina o trota el circuito completo una vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine Karte und zeichnen Sie eine grobe 2-Meilen- oder 3-km-Runde in Ihrer Nähe ein. Gehen oder joggen Sie dann die gesamte Runde einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une carte et tracez une boucle approximative de 2 miles ou 3 km près de chez vous, puis marchez ou courez une fois sur la boucle complète."
          }
        }
      }
    },
    "quest.adventure-038": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a farmer's market or local market and walk one full lap, talking to at least one vendor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra un mercado de agricultores o mercado local y da una vuelta completa, hablando con al menos un vendedor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such einen Bauernmarkt oder einen lokalen Markt auf, geh eine ganze Runde und sprich dabei mit mindestens einem Verkäufer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un marché fermier ou un marché local et faites un tour complet en discutant avec au moins un vendeur."
          }
        }
      }
    },
    "quest.adventure-039": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a random small business, buy something minor if you can, and have a short chat with the person working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra a un pequeño negocio al azar, compra algo menor si puedes, y ten una breve conversación con la persona que trabaja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betreten Sie ein beliebiges kleines Unternehmen, kauf, wenn möglich, etwas Kleineres und unterhalten Sie sich kurz mit der Person, die dort arbeitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez dans une petite entreprise au hasard, achetez quelque chose de mineur si vous le pouvez et discutez brièvement avec la personne qui travaille."
          }
        }
      }
    },
    "quest.adventure-040": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a landmark, statue, or mural and physically go stand right beside it instead of just passing by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un monumento, estatua o mural y ve físicamente a pararte justo al lado en lugar de solo pasar de largo."
