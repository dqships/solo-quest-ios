    "quest.status-091": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 20 minutes deleting old screenshots, memes, and clutter from your camera roll so your recent photos feel more curated."
          }
        },
        "es": {
