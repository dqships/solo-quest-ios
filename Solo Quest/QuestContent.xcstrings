          }
        }
      }
    },
    "quest.rejection-095": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone for their number or social handle, and if they hesitate or say no, respond with genuine \"All good, nice meeting you.\" and mean it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a alguien su número o red social, y si dudan o dicen que no, responde con un genuino \"Todo bien, gusto conocerte\" y que sea de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden nach seiner Nummer oder seinem sozialen Netzwerknamen, und wenn er zögert oder nein sagt, antworte mit einem aufrichtigen „Alles gut, schön, Sie kennenzulernen.“ und mein es ernst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un son numéro ou son identifiant social, et s'il hésite ou dit non, répondez par un véritable « Très bien, ravi de vous rencontrer ». et je le pense."
          }
        }
      }
    },
    "quest.rejection-096": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have one night where your only metric of success is number of conversations started, not numbers or dates gained. Aim for at least 8 openings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una noche donde tu única métrica de éxito sea el número de conversaciones iniciadas, no números o citas ganadas. Apunta a al menos 8 aperturas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe einen Abend, an dem Ihr einziger Erfolgsmaßstab die Anzahl der begonnenen Gespräche ist, nicht die Anzahl oder gewonnenen Daten. Streben Sie mindestens 8 Öffnungen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez une soirée où votre seule mesure de succès est le nombre de conversations commencées, et non le nombre ou les dates gagnées. Visez au moins 8 ouvertures."
          }
        }
      }
    },
    "quest.rejection-097": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what they think makes a good conversation with a stranger and listen to their full answer without interrupting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien qué creen que hace una buena conversación con un extraño y escucha su respuesta completa sin interrumpir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was seiner Meinung nach ein gutes Gespräch mit einem Fremden ausmacht, und hör sich seine vollständige Antwort an, ohne ihn zu unterbrechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un ce qui, selon lui, constitue une bonne conversation avec un inconnu et écoutez sa réponse complète sans l'interrompre."
          }
        }
      }
    },
    "quest.rejection-098": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel intimidated by someone's looks or presence, walk directly past them once with your posture tall, then later give one small compliment if the moment feels right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te sientas intimidado/a por la apariencia o presencia de alguien, pasa directamente junto a ellos una vez con tu postura erguida, luego más tarde da un pequeño cumplido si el momento se siente correcto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie sich durch das Aussehen oder die Anwesenheit einer Person eingeschüchtert fühlen, geh einmal mit aufrechter Haltung direkt an der Person vorbei und mach später ein kleines Kompliment, wenn sich der Moment richtig anfühlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous vous sentez intimidé par l'apparence ou la présence de quelqu'un, passez directement devant lui une fois avec votre posture haute, puis faites plus tard un petit compliment si le moment vous convient."
          }
        }
      }
    },
    "quest.rejection-099": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one person from a short, fun interaction to exchanging contact info within the same outing, even if your voice shakes a little."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva a una persona de una interacción corta y divertida a intercambiar información de contacto dentro de la misma salida, aunque tu voz tiemble un poco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe eine Person von einer kurzen, unterhaltsamen Interaktion zum Austausch von Kontaktinformationen im selben Ausflug, auch wenn Ihre Stimme ein wenig zittert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
