    "quest.everyday-211": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start getting ready for bed 15 minutes earlier than usual tonight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a prepararte para dormir 15 minutos antes de lo habitual esta noche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach sich heute Abend 15 Minuten früher als gewöhnlich bettfertig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à vous préparer à vous coucher 15 minutes plus tôt que d’habitude ce soir."
          }
        }
      }
    },
    "quest.everyday-212": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put tomorrow's first task on paper before bed so you do not carry it in your head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de dormir, escribe en papel la primera tarea de mañana para no seguir llevándola en la cabeza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib die erste Aufgabe von morgen vor dem Schlafengehen zu Papier, damit Sie sie nicht im Kopf herumtragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez la première tâche de demain sur papier avant de vous coucher pour ne pas la porter dans votre tête."
          }
        }
      }
    },
    "quest.everyday-213": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim the lights for the last 20 minutes before you try to sleep tonight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la intensidad de las luces durante los últimos 20 minutos antes de intentar dormir esta noche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimme das Licht in den letzten 20 Minuten, bevor Sie versuchen, heute Nacht zu schlafen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baissez les lumières pendant les 20 dernières minutes avant d'essayer de dormir ce soir."
          }
        }
      }
    },
    "quest.everyday-214": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your charger where it will not tempt you to keep scrolling in bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu cargador en un lugar que no te tiente a seguir deslizando en la cama."
          }
