        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuch ein Denkmal, eine Gedenkstätte oder eine historische Gedenktafel, lies jedes Wort und mach dann ein Foto davon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitez un monument, un mémorial ou une plaque historique et lisez chaque mot, puis prenez-en une photo."
