    "quest.friendship-013": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want to try a new restaurant, café, or food spot with you this week and actually set a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere probar un nuevo restaurante, café o lugar de comida contigo esta semana y fija una hora."
          }
