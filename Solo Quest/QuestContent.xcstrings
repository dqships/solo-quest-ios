    "quest.adventure-011": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up a free event in your city this week, such as a market, meetup, fair, or festival, and show up for at least 45 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca un evento gratuito en tu ciudad esta semana, como un mercado, encuentro, feria o festival, y asiste al menos 45 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such diese Woche nach einer kostenlosen Veranstaltung in Ihrer Stadt, z. B. einem Markt, einem Treffen, einer Messe oder einem Festival, und kommen Sie mindestens 45 Minuten lang vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez un événement gratuit dans votre ville cette semaine, comme un marché, une rencontre, une foire ou un festival, et présentez-vous pendant au moins 45 minutes."
          }
