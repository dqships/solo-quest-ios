      }
    },
    "quest.friendship-017": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone you already know casually if they'd like to hang out one-on-one for the first time."
          }
        },
        "es": {
