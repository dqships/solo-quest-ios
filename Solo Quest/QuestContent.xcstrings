          }
        }
      }
    },
    "quest.status-088": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one small corner in your room that looks aesthetically pleasing from one camera angle and take a photo or video in that spot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una pequeña esquina en tu cuarto que se vea estéticamente agradable desde un ángulo de cámara y toma una foto o video en ese lugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine kleine Ecke in Ihrem Zimmer, die aus einem Kamerawinkel ästhetisch ansprechend aussieht, und mach an dieser Stelle ein Foto oder Video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un petit coin dans votre pièce qui semble esthétique sous un angle de caméra et prenez une photo ou une vidéo à cet endroit."
          }
        }
      }
    },
    "quest.status-089": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a store you would shop in if you had more money and note the kind of pieces your future self would wear without buying anything yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una tienda donde comprarías si tuvieras más dinero y nota el tipo de prendas que tu yo futuro usaría sin comprar nada todavía."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in ein Geschäft, in dem Sie einkaufen würden, wenn Sie mehr Geld hätten, und achte darauf, welche Stücke Ihr zukünftiges Ich tragen würde, ohne noch etwas zu kaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez-vous dans un magasin dans lequel vous feriez vos achats si vous aviez plus d'argent et notez le type de pièces que votre futur moi porterait sans encore rien acheter."
          }
        }
      }
    },
    "quest.status-090": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say your order clearly and confidently to a server or barista, make eye contact, and respond with a genuine thank you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di tu orden clara y confiadamente a un mesero o barista, haz contacto visual, y responde con un gracias genuino."
