    "quest.status-099": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go out one day with your hair, outfit, and scent fully intentional, assuming you could run into anyone from your past or future."
