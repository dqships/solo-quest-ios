    "quest.rejection-060": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what their favorite type of night out is such as quiet bar, loud club, or house hang and share your own answer."
