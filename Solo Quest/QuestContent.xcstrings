    "quest.friendship-019": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want to start a tiny ritual with you such as weekly walks, calls, or gym sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere empezar un pequeño ritual contigo como caminatas semanales, llamadas o sesiones de gimnasio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er mit Ihnen ein kleines Ritual wie wöchentliche Spaziergänge, Anrufe oder Trainingseinheiten im Fitnessstudio beginnen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il souhaite commencer un petit rituel avec vous, comme des promenades hebdomadaires, des appels ou des séances de gym."
          }
        }
      }
    },
    "quest.friendship-020": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to bring a friend and meet you somewhere public, letting your circles overlap a little."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a traer un amigo/a y reunirse contigo en un lugar público, dejando que sus círculos se crucen un poco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, einen Freund mitzubringen und Sie an einem öffentlichen Ort zu treffen, sodass sich Ihre Kreise ein wenig überschneiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à amener un ami et à vous rencontrer dans un endroit public, en laissant vos cercles se chevaucher un peu."
          }
