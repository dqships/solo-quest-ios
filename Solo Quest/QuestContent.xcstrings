    "quest.rejection-089": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End a conversation on purpose while it's still going well by saying you enjoyed talking and wishing them a good night, instead of waiting for awkward silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina una conversación a propósito mientras todavía va bien diciendo que disfrutaste hablar y deseándoles buena noche, en lugar de esperar el silencio incómodo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende ein Gespräch absichtlich, während es noch gut läuft, indem Sie sagen, dass Ihnen das Gespräch Spaß gemacht hat, und wünschen Sie ihnen eine gute Nacht, anstatt auf unangenehme Stille zu warten."
          }
        },
        "fr": {
