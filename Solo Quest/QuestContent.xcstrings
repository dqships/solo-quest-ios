            "value": "Pregúntale a alguien sobre lo que está leyendo, usando o trabajando y déjalos hablar por al menos 30 segundos antes de responder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was er gerade liest, trägt oder woran er arbeitet, und lassen Sie ihn mindestens 30 Sekunden lang sprechen, bevor Sie antworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un ce qu'il lit, porte ou travaille et laissez-le parler pendant au moins 30 secondes avant de répondre."
          }
        }
      }
    },
    "quest.rejection-024": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give one compliment that is not about looks but about vibe or behavior such as \"You seem like you're having a fun night, I like that.\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un cumplido que no sea sobre apariencia sino sobre vibra o comportamiento como \"Parece que la estás pasando bien, me gusta eso.\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ein Kompliment, bei dem es nicht um das Aussehen, sondern um die Stimmung oder das Verhalten geht, wie zum Beispiel „Du scheinst einen lustigen Abend zu haben, das gefällt mir.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un compliment qui ne concerne pas l'apparence mais l'ambiance ou le comportement, par exemple : \"Vous avez l'air de passer une soirée amusante, j'aime ça.\""
          }
        }
      }
    },
    "quest.rejection-025": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what they're celebrating or what the occasion is for their night out if it feels appropriate and natural."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien qué está celebrando o cuál es la ocasión de su salida si se siente apropiado y natural."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was er feiert oder zu welchem Anlass er ausgeht, wenn es sich angemessen und natürlich anfühlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un ce qu'il célèbre ou quelle est l'occasion de sa soirée si cela vous semble approprié et naturel."
          }
        }
      }
    },
    "quest.rejection-026": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask if a seat near someone is taken, sit down, and have at least 90 seconds of conversation before leaving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta si un asiento cerca de alguien está ocupado, siéntate, y ten al menos 90 segundos de conversación antes de irte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag, ob ein Platz neben jemandem belegt ist, setz sich und unterhalten Sie sich mindestens 90 Sekunden lang, bevor Sie gehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez si un siège près de quelqu'un est pris, asseyez-vous et discutez au moins 90 secondes avant de partir."
          }
        }
      }
    },
    "quest.rejection-027": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone to take a photo of you or your group, then thank them and add one extra line of small talk before parting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a alguien que te tome una foto a ti o a tu grupo, luego agradece y añade una línea extra de charla antes de despedirte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte jemanden, ein Foto von Ihnen oder Ihrer Gruppe zu machen, danke ihm und füge vor dem Abschied noch eine Zeile Smalltalk hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un de prendre une photo de vous ou de votre groupe, puis remerciez-le et ajoutez une ligne supplémentaire de petite conversation avant de vous séparer."
          }
        }
      }
    },
    "quest.rejection-028": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a respectful compliment to someone in a group and then walk away without lingering or hovering around them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale un cumplido respetuoso a alguien en un grupo y luego aléjate sin quedarte o rondar a su alrededor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach jemandem in der Gruppe ein respektvolles Kompliment und geh dann weg, ohne zu verweilen oder in seiner Nähe zu stehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un compliment respectueux à quelqu'un dans un groupe, puis éloignez-vous sans vous attarder ni planer autour d'eux."
          }
        }
      }
    },
    "quest.rejection-029": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone for a bar, restaurant, or café recommendation, then ask if they've been anywhere similar recently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a alguien una recomendación de bar, restaurante o café, luego pregunta si han ido a algún lugar similar recientemente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte jemanden um eine Bar-, Restaurant- oder Café-Empfehlung und frag dann, ob er in letzter Zeit irgendwo Ähnliches besucht hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un de vous recommander un bar, un restaurant ou un café, puis demandez-lui s'il est allé dans un endroit similaire récemment."
          }
        }
      }
    },
    "quest.rejection-030": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a conversation with someone you find attractive, hold comfortable eye contact for at least 10 seconds at a time while you talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una conversación con alguien que te parezca atractivo/a, mantén contacto visual cómodo por al menos 10 segundos a la vez mientras hablas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte während eines Gesprächs mit jemandem, den Sie attraktiv finden, mindestens 10 Sekunden lang angenehmen Augenkontakt, während Sie sprechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors d'une conversation avec quelqu'un que vous trouvez attirant, maintenez un contact visuel confortable pendant au moins 10 secondes à la fois pendant que vous parlez."
          }
        }
      }
    },
    "quest.rejection-031": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what kind of music they like and follow up with a question about artists, concerts, or playlists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien qué tipo de música le gusta y haz seguimiento con una pregunta sobre artistas, conciertos o playlists."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, welche Art von Musik er mag, und stell anschließend eine Frage zu Künstlern, Konzerten oder Playlists."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un quel genre de musique il aime et posez une question sur les artistes, les concerts ou les listes de lecture."
          }
        }
      }
    },
    "quest.rejection-032": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approach someone who is also alone at an event and ask how they heard about it, then share how you found it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acércate a alguien que también esté solo/a en un evento y pregunta cómo se enteró, luego comparte cómo lo encontraste tú."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich jemanden an, der bei einer Veranstaltung ebenfalls alleine ist, und frag, wie er davon erfahren hat, und teile dann mit, wie Sie es gefunden haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abordez quelqu'un qui est également seul lors d'un événement et demandez-lui comment il en a entendu parler, puis partagez comment vous l'avez trouvé."
          }
        }
      }
    },
    "quest.rejection-033": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what a perfect off-day looks like for them, then share what a perfect day off looks like for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien cómo es un día libre perfecto para ellos, luego comparte cómo es un día libre perfecto para ti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, wie für ihn ein perfekter freier Tag aussieht, und teile ihm dann mit, wie ein perfekter freier Tag für Sie aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un à quoi ressemble un jour de congé parfait pour lui, puis partagez à quoi ressemble un jour de congé parfait pour vous."
          }
        }
      }
    },
    "quest.rejection-034": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a compliment and stay present if they compliment you back instead of deflecting or talking yourself down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un cumplido y mantente presente si te devuelven el cumplido en lugar de desviar o menospreciarte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ein Kompliment und bleib präsent, wenn jemand Ihnen ein Kompliment erwidert, statt abzulenken oder sich selbst herunterzureden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un compliment et restez présent s'ils vous complimentent en retour au lieu de vous détourner ou de vous dénigrer."
          }
        }
      }
    },
    "quest.rejection-035": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask where they got a specific item they're wearing, respond with real interest, and then let the conversation end naturally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta dónde consiguieron algo específico que están usando, responde con interés real, y luego deja que la conversación termine naturalmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag, woher sie ein bestimmtes Kleidungsstück haben, antworte mit echtem Interesse und lassen Sie das Gespräch dann ganz natürlich enden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-leur où ils ont obtenu un article spécifique qu'ils portent, répondez avec un réel intérêt, puis laissez la conversation se terminer naturellement."
          }
        }
      }
    },
    "quest.rejection-036": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one night out, intentionally start conversations with at least 3 different people or groups you didn't know."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una noche de salida, inicia intencionalmente conversaciones con al menos 3 personas o grupos diferentes que no conocías."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne an einem Abend absichtlich Gespräche mit mindestens drei verschiedenen Personen oder Gruppen, die Sie nicht kennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au cours d'une soirée, démarrez intentionnellement des conversations avec au moins 3 personnes ou groupes différents que vous ne connaissez pas."
          }
        }
      }
    },
    "quest.rejection-037": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone if they are originally from this city and ask what they like or don't like about living here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien si es originalmente de esta ciudad y qué le gusta o no le gusta de vivir aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, ob er ursprünglich aus dieser Stadt stammt und was ihm am Leben hier gefällt oder nicht gefällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un s'il est originaire de cette ville et demandez-lui ce qu'il aime ou n'aime pas dans la vie ici."
          }
        }
      }
    },
    "quest.rejection-038": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On purpose, collect 3 gentle rejections in one night by respectfully approaching people and accepting any no with a smile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A propósito, colecciona 3 rechazos suaves en una noche acercándote respetuosamente a personas y aceptando cualquier no con una sonrisa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle absichtlich drei sanfte Ablehnungen in einer Nacht ein, indem Sie respektvoll auf die Menschen zugehen und jedes Nein mit einem Lächeln akzeptieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récoltez volontairement 3 refus doux en une nuit en vous approchant respectueusement des gens et en acceptant tout non avec le sourire."
          }
        }
      }
    },
    "quest.rejection-039": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what they do for fun outside of work and let them talk for at least 45 seconds without interrupting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien qué hace para divertirse fuera del trabajo y déjalos hablar por al menos 45 segundos sin interrumpir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was er außerhalb der Arbeit zum Spaß macht, und lassen Sie ihn mindestens 45 Sekunden lang reden, ohne ihn zu unterbrechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un ce qu'il fait pour s'amuser en dehors du travail et laissez-le parler pendant au moins 45 secondes sans l'interrompre."
          }
        }
      }
    },
    "quest.rejection-040": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a stranger or group if they know another good spot nearby and consider actually going to their suggestion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un extraño o grupo si conocen otro buen lugar cerca y considera ir realmente a su sugerencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Fremden oder eine Gruppe, ob sie einen anderen guten Ort in der Nähe kennen, und denken Sie darüber nach, ihrem Vorschlag tatsächlich nachzukommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un étranger ou à un groupe s'ils connaissent un autre bon endroit à proximité et envisagez de suivre leur suggestion."
          }
        }
      }
    },
    "quest.rejection-041": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a conversation with someone you're attracted to, consciously slow down your speech instead of rushing or rambling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una conversación con alguien que te atrae, conscientemente disminuye la velocidad de tu habla en lugar de apresurarte o divagar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie sich mit jemandem unterhalten, zu dem Sie sich hingezogen fühlen, sprich bewusst langsamer, anstatt zu hetzen oder zu schwafeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors d'une conversation avec une personne qui vous attire, ralentissez consciemment votre discours au lieu de vous précipiter ou de divaguer."
          }
        }
      }
    },
    "quest.rejection-042": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what their go-to comfort food or show is and share yours after they answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien cuál es su comida o serie de confort favorita y comparte la tuya después de que responda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was sein Lieblingsessen oder seine Lieblingssendung ist, und teile es mit, nachdem er geantwortet hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un quel est son plat réconfortant ou son spectacle préféré et partagez le vôtre après avoir répondu."
          }
        }
      }
    },
    "quest.rejection-043": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk up to someone and say, \"You seemed cool, I wanted to say hi,\" then introduce yourself and ask their name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acércate a alguien y di \"Me pareciste cool, quería saludarte\" luego preséntate y pregunta su nombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh auf jemanden zu und sag: „Sie schienen cool zu sein, ich wollte Hallo sagen“, stell sich dann vor und frag nach seinem Namen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez-vous de quelqu'un et dites : « Vous aviez l'air cool, je voulais lui dire bonjour », puis présentez-vous et demandez-lui son nom."
          }
        }
      }
    },
    "quest.rejection-044": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compliment someone's style, then ask how they would describe their style or where they like to shop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elogia el estilo de alguien, luego pregunta cómo describirían su estilo o dónde les gusta comprar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach jemandem ein Kompliment für seinen Stil und frag dann, wie er seinen Stil beschreiben würde oder wo er gerne einkauft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complimentez le style de quelqu'un, puis demandez-lui comment il décrirait son style ou où il aime faire ses achats."
          }
        }
      }
    },
    "quest.rejection-045": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join a dance floor or high-energy area for at least one whole song even if you feel awkward and self-conscious."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a una pista de baile o área de alta energía por al menos una canción completa aunque te sientas incómodo/a y cohibido/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh für mindestens ein ganzes Lied auf die Tanzfläche oder in einen energiegeladenen Bereich, auch wenn Sie sich unbehaglich und unsicher fühlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez une piste de danse ou un espace à haute énergie pour au moins une chanson entière, même si vous vous sentez mal à l'aise et gêné."
          }
        }
      }
    },
    "quest.rejection-046": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone to recommend a song or artist, then later that night actually listen to at least one track from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a alguien que recomiende una canción o artista, luego esa noche escucha al menos una canción de ellos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte jemanden, ein Lied oder einen Künstler zu empfehlen, und hör sich später am Abend tatsächlich mindestens einen Titel von ihm an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un de recommander une chanson ou un artiste, puis plus tard dans la soirée, écoutez au moins un de ses morceaux."
          }
        }
      }
    },
    "quest.rejection-047": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
