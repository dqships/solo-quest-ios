        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une note vocale à [person] pour lui dire une chose que vous appréciez vraiment chez elle."
          }
        }
      }
    },
    "quest.friendship-005": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a coworker, neighbor, or classmate if they want to grab lunch or a quick snack after work or class."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un compañero de trabajo, vecino o compañero de clase si quiere ir a almorzar o tomar un snack rápido después del trabajo o clase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Kollegen, Nachbarn oder Klassenkameraden, ob er nach der Arbeit oder dem Unterricht ein Mittagessen oder einen schnellen Snack einnehmen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un collègue, un voisin ou un camarade de classe s'il souhaite prendre un déjeuner ou une collation rapide après le travail ou les cours."
          }
        }
      }
    },
    "quest.friendship-006": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to do a walk-and-talk hang in your neighborhood, park, or downtown area for at least 30 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a dar un paseo y platicar en tu vecindario, parque o centro de la ciudad por al menos 30 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem mindestens 30-minütigen Walk-and-Talk-Treffen in Ihrer Nachbarschaft, Ihrem Park oder Ihrer Innenstadt ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à marcher et à discuter dans votre quartier, parc ou centre-ville pendant au moins 30 minutes."
          }
        }
      }
    },
    "quest.friendship-007": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one online friend or supporter and ask if they'd ever want to do a 20–30 minute video call to connect more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un amigo/a o seguidor en línea y pregúntale si le gustaría hacer una videollamada de 20-30 minutos para conectar más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Online-Freund oder Unterstützer aus und frag ihn, ob er jemals einen 20–30-minütigen Videoanruf durchführen möchte, um mehr Kontakte zu knüpfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un ami ou un sympathisant en ligne et demandez-lui s'il souhaiterait un jour passer un appel vidéo de 20 à 30 minutes pour se connecter davantage."
