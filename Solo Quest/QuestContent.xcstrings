        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in eine Hotellobby, als ob Sie dorthin gehören würden, such sich einen Sitzplatz und entspannen Sie sich dort oder schreib dort mindestens 15 Minuten lang Tagebuch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
