    "quest.adventure-001": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a bus, train, or rideshare to a neighborhood you've never walked in before and explore it on foot for at least 30 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un autobús, tren o viaje compartido a un vecindario en el que nunca hayas caminado y explóralo a pie durante al menos 30 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahr mit dem Bus, der Bahn oder einer Mitfahrgelegenheit in ein Viertel, das Sie noch nie zuvor betreten haben, und erkunde es mindestens 30 Minuten lang zu Fuß."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un bus, un train ou un covoiturage vers un quartier dans lequel vous n'avez jamais marché auparavant et explorez-le à pied pendant au moins 30 minutes."
          }
        }
      }
    },
    "quest.adventure-002": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a hiking trail or nature path within an hour of you and walk until you reach a clear viewpoint, then take a photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra un sendero o camino natural a menos de una hora de ti y camina hasta llegar a un mirador despejado, luego toma una foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde einen Wanderweg oder Naturpfad im Umkreis von einer Stunde und geh, bis Sie einen klaren Aussichtspunkt erreichen, und mach dann ein Foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un sentier de randonnée ou un sentier naturel à moins d'une heure de chez vous et marchez jusqu'à atteindre un point de vue dégagé, puis prenez une photo."
          }
        }
      }
    },
    "quest.adventure-003": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a local park and join a pickup game such as basketball, soccer, or frisbee for at least one round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un parque local y únete a un juego improvisado como baloncesto, fútbol o frisbee por al menos una ronda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in einen örtlichen Park und nimm mindestens eine Runde lang an einem spannenden Spiel wie Basketball, Fußball oder Frisbee teil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez-vous dans un parc local et participez à un jeu de ramassage comme le basket-ball, le football ou le frisbee pendant au moins une partie."
          }
        }
      }
    },
    "quest.adventure-004": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a museum, gallery, or exhibit you've never been to and stay until you've really studied at least 5 pieces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita un museo, galería o exposición donde nunca hayas estado y quédate hasta que hayas estudiado realmente al menos 5 obras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuch ein Museum, eine Galerie oder eine Ausstellung, in der Sie noch nie waren, und bleib, bis Sie mindestens fünf Stücke wirklich studiert haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitez un musée, une galerie ou une exposition où vous n'êtes jamais allé et restez jusqu'à ce que vous ayez vraiment étudié au moins 5 pièces."
          }
        }
      }
    },
    "quest.adventure-005": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into a bar, café, or venue alone, sit at the bar or counter, and stay for one full drink or snack while people-watching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra solo/a a un bar, café o local, siéntate en la barra o mostrador, y quédate una bebida o snack completo mientras observas a la gente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh allein in eine Bar, ein Café oder einen Veranstaltungsort, setz sich an die Bar oder den Tresen und genieße ein volles Getränk oder einen Snack, während Sie die Leute beobachten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez seul dans un bar, un café ou un lieu, asseyez-vous au bar ou au comptoir et restez pour un verre complet ou une collation tout en regardant les gens."
          }
        }
      }
    },
    "quest.adventure-006": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a live show happening tonight such as music, comedy, or open mic and attend it, even if you go solo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra un espectáculo en vivo esta noche como música, comedia o micrófono abierto y asiste, aunque vayas solo/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde heute Abend eine Live-Show wie Musik, Comedy oder Open Mic und besuch sie, auch wenn Sie alleine auftreten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un spectacle en direct ce soir, comme de la musique, de la comédie ou un micro ouvert, et assistez-y, même si vous y allez en solo."
          }
        }
      }
    },
    "quest.adventure-007": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a different public transport route than usual and ride to the end of the line just to see what's there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una ruta de transporte público diferente a la habitual y viaja hasta el final de la línea solo para ver qué hay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm eine andere öffentliche Verkehrsmittelroute als üblich und fahr bis zur Endstation, um zu sehen, was dort ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un itinéraire de transport en commun différent de celui habituel et roulez jusqu'au bout de la file juste pour voir ce qu'il y a là."
          }
        }
      }
    },
    "quest.adventure-008": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent or borrow a bike or scooter and ride a new route for at least 30 minutes through parts of town you rarely see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquila o pide prestada una bicicleta o scooter y recorre una nueva ruta durante al menos 30 minutos por partes de la ciudad que rara vez ves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieten oder leih sich ein Fahrrad oder einen Roller und fahr mindestens 30 Minuten lang eine neue Route durch Teile der Stadt, die Sie selten sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Louez ou empruntez un vélo ou un scooter et parcourez un nouvel itinéraire pendant au moins 30 minutes à travers des quartiers de la ville que vous voyez rarement."
          }
        }
      }
    },
    "quest.adventure-009": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a busy area and ask three strangers for local recommendations for food or places to visit and write them down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una zona concurrida y pide a tres desconocidos recomendaciones locales de comida o lugares para visitar y anótalas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in eine belebte Gegend und frag drei Fremde nach lokalen Empfehlungen für Essen oder Sehenswürdigkeiten und schreib diese auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans une zone très fréquentée et demandez à trois inconnus des recommandations locales sur la nourriture ou les endroits à visiter et notez-les."
          }
        }
      }
    },
    "quest.adventure-010": {
      "extractionState": "stale",
      "localizations": {
