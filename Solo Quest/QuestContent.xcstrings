    },
    "quest.adventure-052": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit by a window in a building at least three floors up and spend 10 minutes just watching the street below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate junto a una ventana en un edificio de al menos tres pisos y pasa 10 minutos solo observando la calle abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich an ein Fenster in einem Gebäude, das mindestens drei Stockwerke höher liegt, und verbringe 10 Minuten damit, die Straße darunter zu beobachten."
          }
        },
        "fr": {
          "stringUnit": {
