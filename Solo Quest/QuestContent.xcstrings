        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh zum ältesten Gebäude oder Bereich, den Sie leicht erreichen können, und verbringe ein paar Minuten damit, dort zu stehen und sich seine Geschichte vorzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez jusqu'au bâtiment ou à la zone la plus ancienne à laquelle vous pouvez facilement accéder et passez quelques minutes à imaginer son histoire."
          }
        }
      }
    },
    "quest.adventure-043": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a staircase with at least three flights and walk them all twice, up and down."
