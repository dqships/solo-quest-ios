    "quest.adventure-047": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a monument, memorial, or historical plaque and read every word, then take a photo of it."
          }
        },
        "es": {
