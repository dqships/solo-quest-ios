    "quest.rejection-063": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approach someone with headphones in, politely gesture, and ask if they have a minute to answer a fun question. If they say no, thank them and move on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acércate a alguien con audífonos, haz un gesto educado, y pregunta si tiene un minuto para responder una pregunta divertida. Si dice que no, agradece y sigue adelante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh auf jemanden mit Kopfhörern zu, gestikulieren Sie höflich und frag, ob er eine Minute Zeit hat, um eine lustige Frage zu beantworten. Wenn sie Nein sagen, danke ihnen und mach weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez-vous de quelqu'un avec des écouteurs, faites un geste poli et demandez-lui s'il a une minute pour répondre à une question amusante. S'ils disent non, remerciez-les et passez à autre chose."
          }
        }
      }
    },
    "quest.rejection-064": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what they're celebrating if they're clearly in a fun group mood, then wish them a genuinely good night."
