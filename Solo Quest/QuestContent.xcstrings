          }
        }
      }
    },
    "quest.adventure-042": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the oldest building or area you can easily get to and spend a few minutes actually standing there imagining its history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina al edificio o área más antigua que puedas alcanzar fácilmente y pasa unos minutos parado ahí imaginando su historia."
          }
