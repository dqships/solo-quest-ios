    "quest.date-063": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a rooftop, balcony, or park late enough to see stars or the night sky and stay until you feel your body fully relax."
