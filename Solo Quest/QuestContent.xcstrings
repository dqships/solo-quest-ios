    "quest.adventure-046": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a 45 minute \"getting lost\" walk where you intentionally avoid your usual routes, then navigate back home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da una caminata de 45 minutos de \"perderte\" donde evites intencionalmente tus rutas habituales, luego navega de regreso a casa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen 45-minütigen „Verlorengehen“-Spaziergang, bei dem Sie Ihre üblichen Routen bewusst meiden, und navigieren Sie dann zurück nach Hause."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une promenade de 45 minutes pour vous perdre en évitant intentionnellement vos itinéraires habituels, puis rentrez chez vous."
