      }
    },
    "quest.friendship-023": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize a tiny group hang of 3–5 people at a bar, café, park, or someone's living room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza una pequeña reunión grupal de 3-5 personas en un bar, café, parque o sala de alguien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisiere eine kleine Gruppe von 3–5 Personen in einer Bar, einem Café, einem Park oder im Wohnzimmer einer anderen Person."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez un petit groupe de 3 à 5 personnes dans un bar, un café, un parc ou dans le salon de quelqu'un."
          }
        }
      }
    },
    "quest.friendship-024": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend from your past neighborhood or school to catch up on a call or in person for at least 20 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a un amigo/a de tu antiguo vecindario o escuela ponerse al día en una llamada o en persona por al menos 20 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte einen Freund aus Ihrer früheren Nachbarschaft oder Schule, mindestens 20 Minuten lang telefonisch oder persönlich vorbeizuschauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami de votre ancien quartier ou école de répondre à un appel ou en personne pendant au moins 20 minutes."
          }
        }
      }
    },
    "quest.friendship-025": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to join you for a gym session, walk, or physical activity and actually show up on time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a unirse a ti para una sesión de gimnasio, caminata o actividad física y llega puntual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einer Trainingseinheit, einem Spaziergang oder einer körperlichen Aktivität ein und zeig dich pünktlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à vous rejoindre pour une séance de gym, une marche ou une activité physique et à vous présenter à l'heure."
          }
        }
      }
    },
    "quest.friendship-026": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend what they're excited about right now in life and ask at least one follow-up question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a qué le emociona en este momento de su vida y haz al menos una pregunta de seguimiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, worüber er sich gerade im Leben freut, und stell mindestens eine Folgefrage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami ce qui l'enthousiasme en ce moment dans la vie et posez au moins une question de suivi."
          }
        }
      }
    },
    "quest.friendship-027": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host a low-budget game night using whatever games or card decks you already have and invite at least 2 people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza una noche de juegos de bajo presupuesto usando los juegos o barajas que ya tengas e invita al menos a 2 personas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veranstalten Sie einen Low-Budget-Spieleabend mit den Spielen oder Kartendecks, die Sie bereits haben, und lade mindestens zwei Personen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez une soirée de jeux à petit budget en utilisant les jeux ou les jeux de cartes que vous possédez déjà et invitez au moins 2 personnes."
          }
        }
      }
    },
    "quest.friendship-028": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send [person] a link to a song, video, or meme that genuinely made you think of them and say why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía a [person] un enlace a una canción, video o meme que genuinamente te hizo pensar en él/ella y explica por qué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende [person] einen Link zu einem Lied, Video oder Meme, das Sie wirklich an die Person erinnert hat, und sag, warum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez à [person] un lien vers une chanson, une vidéo ou un mème qui vous a vraiment fait penser à elle et dites pourquoi."
          }
        }
      }
    },
    "quest.friendship-029": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone in your life what they're struggling with lately and just listen without giving advice unless they ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien en tu vida con qué está luchando últimamente y solo escucha sin dar consejos a menos que te lo pidan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden in Ihrem Leben, womit er in letzter Zeit zu kämpfen hat, und hör einfach zu, ohne Ratschläge zu geben, es sei denn, er fragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un dans votre vie avec quoi il lutte ces derniers temps et écoutez simplement sans donner de conseils à moins qu'il ne le demande."
          }
        }
      }
    },
    "quest.friendship-030": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to run an errand with you such as shopping, picking something up, or dropping something off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a hacer un mandado contigo como ir de compras, recoger o dejar algo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, mit Ihnen eine Besorgung zu erledigen, z. B. einzukaufen, etwas abzuholen oder abzugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à faire une course avec vous, comme faire du shopping, récupérer ou déposer quelque chose."
          }
        }
      }
    },
    "quest.friendship-031": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join a recurring local thing such as a weekly class, meetup, or group and actually show up one time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a algo local recurrente como una clase semanal, meetup o grupo y asiste al menos una vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tritt einer wiederkehrenden lokalen Veranstaltung bei, beispielsweise einem wöchentlichen Kurs, einem Treffen oder einer Gruppe, und kommen Sie tatsächlich einmal vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez une activité locale récurrente telle qu'un cours hebdomadaire, une rencontre ou un groupe et présentez-vous une seule fois."
          }
        }
      }
    },
    "quest.friendship-032": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want to do a joint \"work session\" at your place, their place, or a café for 60–90 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere hacer una \"sesión de trabajo\" conjunta en tu casa, su casa o un café por 60-90 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er eine gemeinsame „Arbeitssitzung“ bei Ihnen, bei ihm zu Hause oder in einem Café für 60–90 Minuten machen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il souhaite faire une « séance de travail » commune chez vous, chez lui ou dans un café pendant 60 à 90 minutes."
          }
        }
      }
    },
    "quest.friendship-033": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell [person] directly that you enjoy their company and want to hang out more often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile directamente a [person] que disfrutas su compañía y quieres pasar más tiempo juntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag [person] direkt, dass Ihnen die Gesellschaft gefällt und Sie öfter Zeit mit ihr verbringen möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites directement à [person] que vous appréciez sa compagnie et que vous souhaitez sortir plus souvent."
          }
        }
      }
    },
    "quest.friendship-034": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone new at work, gym, or class how long they've been coming there and what they like about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien nuevo en el trabajo, gimnasio o clase cuánto tiempo lleva yendo y qué le gusta de ahí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, der neu bei der Arbeit, im Fitnessstudio oder in der Klasse ist, wie lange er schon dort ist und was ihm daran gefällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un de nouveau au travail, à la salle de sport ou en classe depuis combien de temps il y vient et ce qu'il aime à ce sujet."
          }
        }
      }
    },
    "quest.friendship-035": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to try a hobby you already like such as music, art, gaming, or gym and show them the basics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a probar un hobby que ya te gusta como música, arte, videojuegos o gimnasio y enséñale lo básico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, ein Hobby auszuprobieren, das Ihnen bereits gefällt, wie Musik, Kunst, Spiele oder Fitnessstudio, und zeigen Sie ihr die Grundlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à essayer un passe-temps que vous aimez déjà, comme la musique, l'art, les jeux vidéo ou la gym, et montrez-lui les bases."
          }
        }
      }
    },
    "quest.friendship-036": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want to plan a micro-trip such as a day trip to a nearby town or park in the next month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere planear un micro-viaje como una excursión de un día a un pueblo o parque cercano el próximo mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er im nächsten Monat einen Mikroausflug planen möchte, beispielsweise einen Tagesausflug in eine nahe gelegene Stadt oder einen Park."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il souhaite planifier un micro-voyage, comme une excursion d'une journée dans une ville ou un parc voisin au cours du mois prochain."
          }
        }
      }
    },
    "quest.friendship-037": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a sincere apology to [person] if there's someone you feel you lowkey dropped, ghosted, or offended in the past."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una disculpa sincera a [person] si hay alguien a quien sientes que dejaste de lado, ignoraste u ofendiste en el pasado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende eine aufrichtige Entschuldigung an [person], wenn es jemanden gibt, von dem Sie das Gefühl haben, dass er Sie in der Vergangenheit zurückhaltend, belästigt oder beleidigt fühlte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez des excuses sincères à [person] s'il y a quelqu'un que vous pensez avoir laissé tomber, fantôme ou offensé dans le passé."
          }
        }
      }
    },
    "quest.friendship-038": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone you respect if they want to grab coffee so you can hear more about their story or path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien que respetas si quiere tomar un café para que puedas escuchar más sobre su historia o camino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, den Sie respektieren, ob er einen Kaffee trinken möchte, damit Sie mehr über seine Geschichte oder seinen Weg erfahren können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un que vous respectez s'il veut prendre un café afin que vous puissiez en savoir plus sur son histoire ou son parcours."
          }
        }
      }
    },
    "quest.friendship-039": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a park hang: one blanket, some snacks, drinks, and at least 45 minutes of conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una reunión en el parque: una manta, snacks, bebidas y al menos 45 minutos de conversación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem Parkhang ein: eine Decke, ein paar Snacks, Getränke und mindestens 45 Minuten Gespräch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à un parc : une couverture, des collations, des boissons et au moins 45 minutes de conversation."
          }
        }
      }
    },
    "quest.friendship-040": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone you already see regularly such as a barista, receptionist, or neighbor what their name is and remember it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien que ya ves regularmente como un barista, recepcionista o vecino cuál es su nombre y recuérdalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, den Sie bereits regelmäßig sehen, z. B. einen Barista, eine Rezeptionistin oder einen Nachbarn, nach seinem Namen und merken Sie sich ihn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un que vous voyez déjà régulièrement, comme un barista, une réceptionniste ou un voisin, quel est son nom et souvenez-vous-en."
          }
        }
      }
    },
    "quest.friendship-041": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send 3 check-in texts today that are more than \"wyd\" and ask something specific about their life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía 3 mensajes de seguimiento hoy que sean más que \"qué haces\" y pregunta algo específico sobre su vida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende heute drei Check-in-SMS, die mehr als nur „Wow“ sind, und frag etwas Konkretes über ihr Leben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez aujourd'hui 3 SMS d'enregistrement qui sont plus que \"wyd\" et posez des questions spécifiques sur leur vie."
          }
        }
      }
    },
    "quest.friendship-042": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a \"no phones\" meal or coffee where both of you keep phones off the table the whole time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una comida o café \"sin teléfonos\" donde ambos mantengan los teléfonos fuera de la mesa todo el tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einer Mahlzeit oder einem Kaffee ohne Telefone ein, bei der Sie beide die ganze Zeit keine Telefone auf dem Tisch haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à un repas ou à un café « sans téléphone » où vous gardez tous les deux les téléphones hors de la table tout le temps."
          }
        }
      }
    },
    "quest.friendship-043": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want help with something specific such as moving, a project, or a creative idea and actually show up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere ayuda con algo específico como mudanza, un proyecto o una idea creativa y realmente presenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er bei etwas Bestimmtem Hilfe braucht, etwa bei einem Umzug, einem Projekt oder einer kreativen Idee, und kommen Sie tatsächlich vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il a besoin d'aide pour quelque chose de spécifique comme un déménagement, un projet ou une idée créative et présentez-vous."
          }
        }
      }
    },
    "quest.friendship-044": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask [person] what they've been proud of lately and reflect it back to them verbally in your own words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a [person] de qué ha estado orgulloso/a últimamente y refleja eso de vuelta verbalmente en tus propias palabras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag [person], worauf sie in letzter Zeit stolz war, und gib es ihr verbal in Ihren eigenen Worten zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à [person] de quoi elle a été fière ces derniers temps et répondez-lui verbalement dans vos propres mots."
          }
        }
      }
    },
    "quest.friendship-045": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite a small group of 3–4 people to a low-key \"bring your own snack\" hang at a park or someone's home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a un pequeño grupo de 3-4 personas a una reunión relajada de \"trae tu propio snack\" en un parque o casa de alguien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade eine kleine Gruppe von 3 bis 4 Personen zu einem unauffälligen „Bring Your Own Snack“-Hang in einem Park oder bei jemandem zu Hause ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez un petit groupe de 3 à 4 personnes à une soirée discrète « apportez votre propre collation » dans un parc ou chez quelqu'un."
          }
        }
      }
    },
    "quest.friendship-046": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend from another city if they'd ever want to visit you and what they'd want to see in your area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a de otra ciudad si le gustaría visitarte y qué le gustaría ver en tu zona."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund aus einer anderen Stadt, ob er Sie jemals besuchen möchte und was er in Ihrer Nähe sehen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami d'une autre ville s'il voudrait un jour vous rendre visite et ce qu'il voudrait voir dans votre région."
          }
        }
      }
    },
    "quest.friendship-047": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send [person] an old photo or screenshot that reminds you of a good memory and talk about it for a bit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía a [person] una foto o captura de pantalla antigua que te recuerde un buen recuerdo y hablen de ello un rato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick [person] ein altes Foto oder einen Screenshot, der Sie an eine schöne Erinnerung erinnert, und sprich ein wenig darüber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez à [person] une vieille photo ou une capture d’écran qui vous rappelle un bon souvenir et parlez-en un peu."
          }
        }
      }
    },
    "quest.friendship-048": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join a group activity where you have to talk to others such as a class, run club, game night, or meetup, and introduce yourself out loud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a una actividad grupal donde tengas que hablar con otros como una clase, club de correr, noche de juegos o meetup, y preséntate en voz alta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm an einer Gruppenaktivität teil, bei der Sie mit anderen sprechen müssen, z. B. in einer Klasse, einem Verein, einem Spieleabend oder einem Treffen, und stell sich laut vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez une activité de groupe où vous devez parler à d'autres personnes, comme une classe, un club de course, une soirée de jeux ou une rencontre, et présentez-vous à voix haute."
          }
        }
      }
    },
    "quest.friendship-049": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone you like hanging out with if they know anyone they think you'd vibe with, and be open to an introduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien con quien te gusta pasar tiempo si conoce a alguien con quien cree que conectarías, y estate abierto/a a una presentación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, mit dem Sie gerne Zeit verbringen, ob er jemanden kennt, mit dem Sie Ihrer Meinung nach harmonieren würden, und seien Sie offen für eine Vorstellung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un avec qui vous aimez sortir s'il connaît quelqu'un avec qui il pense que vous aimeriez vibrer et soyez ouvert à une présentation."
          }
        }
      }
    },
    "quest.friendship-050": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to an early morning walk, coffee, or gym session before noon, then actually show up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una caminata temprano, café o sesión de gimnasio antes del mediodía, y realmente presenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] vor Mittag zu einem Spaziergang am frühen Morgen, einem Kaffee oder einer Trainingseinheit im Fitnessstudio ein und kommen Sie dann tatsächlich vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à une promenade matinale, à un café ou à une séance de gym avant midi, puis présentez-vous."
          }
        }
      }
    },
    "quest.friendship-051": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want to start a monthly ritual such as brunch, movie night, or creative session and schedule the first one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere empezar un ritual mensual como brunch, noche de películas o sesión creativa y agenda la primera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er ein monatliches Ritual wie einen Brunch, einen Filmabend oder eine kreative Sitzung starten möchte, und vereinbare den ersten Termin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il souhaite commencer un rituel mensuel tel qu'un brunch, une soirée cinéma ou une séance créative et planifiez le premier."
          }
        }
      }
    },
    "quest.friendship-052": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer to help [person] with something small such as giving feedback on a project, reading something, or listening to a vent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrece ayudar a [person] con algo pequeño como dar retroalimentación en un proyecto, leer algo o escuchar un desahogo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieten Sie an, [person] bei etwas Kleinem zu helfen, z. B. Feedback zu einem Projekt zu geben, etwas zu lesen oder einer Entlüftung zuzuhören."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposez d'aider [person] avec quelque chose de petit, comme donner son avis sur un projet, lire quelque chose ou écouter un discours."
          }
        }
      }
    },
    "quest.friendship-053": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend their opinion on something that actually matters to you such as a decision, outfit, or plan and thank them for being honest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a un amigo/a su opinión sobre algo que realmente te importa como una decisión, atuendo o plan y agradécele por ser honesto/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund nach seiner Meinung zu etwas, das Ihnen wirklich wichtig ist, beispielsweise zu einer Entscheidung, einem Outfit oder einem Plan, und danke ihm für seine Ehrlichkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami son avis sur quelque chose qui compte vraiment pour vous, comme une décision, une tenue ou un plan, et remerciez-le d'être honnête."
          }
        }
      }
    },
    "quest.friendship-054": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to do a \"no money\" hang like a walk, park sit, or library visit to prove you don't need to spend to socialize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una salida \"sin dinero\" como una caminata, sentarse en el parque o visitar la biblioteca para demostrar que no necesitas gastar para socializar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem „No Money“-Abhang wie einem Spaziergang, einem Parkbesuch oder einem Bibliotheksbesuch ein, um zu beweisen, dass Sie nichts ausgeben müssen, um Kontakte zu knüpfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à faire une activité « sans argent », comme une promenade, une séance dans un parc ou une visite à la bibliothèque pour prouver que vous n'avez pas besoin de dépenser pour socialiser."
          }
        }
      }
    },
    "quest.friendship-055": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text 3 people the same question: \"What's something good that happened to you this week?\" and respond to each answer properly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía a 3 personas la misma pregunta: \"¿Qué algo bueno te pasó esta semana?\" y responde apropiadamente a cada respuesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick drei Personen dieselbe Frage: „Was ist Ihnen diese Woche etwas Gutes passiert?“ und auf jede Antwort richtig antworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez la même question à 3 personnes : \"Qu'est-ce qui vous est arrivé de bien cette semaine ?\" et répondez correctement à chaque réponse."
          }
        }
      }
    },
    "quest.friendship-056": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask [person] if they'd like to collaborate with you on something small such as content, a creative idea, or a side project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a [person] si le gustaría colaborar contigo en algo pequeño como contenido, una idea creativa o un proyecto secundario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag [person], ob sie mit Ihnen an etwas Kleinem zusammenarbeiten möchte, beispielsweise an Inhalten, einer kreativen Idee oder einem Nebenprojekt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à [person] si elle aimerait collaborer avec vous sur quelque chose de petit comme du contenu, une idée créative ou un projet parallèle."
          }
        }
      }
    },
    "quest.friendship-057": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one friend whose work or art you like and promote them once publicly such as sharing their link or story."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un amigo/a cuyo trabajo o arte te guste y promuévelo públicamente una vez, como compartir su enlace o historia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Freund aus, dessen Arbeit oder Kunst Ihnen gefällt, und bewerben Sie ihn einmal öffentlich, indem Sie beispielsweise seinen Link oder seine Geschichte teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un ami dont vous aimez le travail ou l’art et faites-en la promotion une fois publiquement, par exemple en partageant son lien ou son histoire."
          }
        }
      }
    },
    "quest.friendship-058": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to explore a part of town neither of you go to often and walk one full block or area together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a explorar una parte de la ciudad a la que ninguno va frecuentemente y caminen una cuadra o área completa juntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, einen Teil der Stadt zu erkunden, den keiner von Ihnen oft besucht, und gemeinsam einen ganzen Block oder ein ganzes Gebiet zu Fuß zu gehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à explorer une partie de la ville où aucun de vous ne va souvent et à parcourir ensemble un pâté de maisons ou une zone complète."
          }
        }
      }
    },
    "quest.friendship-059": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend from a different background than you about part of their upbringing or culture and listen without centering yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a de diferente trasfondo que tú sobre parte de su crianza o cultura y escucha sin centrarte en ti mismo/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund mit einem anderen Hintergrund als Sie nach einem Teil seiner Erziehung oder Kultur und hör zu, ohne sich zu konzentrieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrogez un ami d'un milieu différent du vôtre sur une partie de son éducation ou de sa culture et écoutez sans vous centrer."
          }
        }
      }
    },
    "quest.friendship-060": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to attend a class, workshop, or meetup with you and actually go, even if you feel awkward at first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a asistir a una clase, taller o meetup contigo y realmente ve, aunque te sientas incómodo/a al principio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, mit Ihnen an einem Kurs, Workshop oder Treffen teilzunehmen, und geh tatsächlich hin, auch wenn Sie sich zunächst unwohl fühlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à assister à un cours, à un atelier ou à une rencontre avec vous et à y aller, même si vous vous sentez gêné au début."
          }
        }
      }
    },
    "quest.friendship-061": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone online who supports your work or content if they'd like to hop on a quick 10–15 minute call sometime to say thanks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien en línea que apoya tu trabajo o contenido si le gustaría hacer una llamada rápida de 10-15 minutos alguna vez para dar las gracias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag online jemanden, der Ihre Arbeit oder Ihre Inhalte unterstützt, ob er irgendwann einmal ein kurzes 10- bis 15-minütiges Gespräch führen möchte, um sich zu bedanken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un en ligne qui soutient votre travail ou votre contenu s'il souhaite parfois passer un appel rapide de 10 à 15 minutes pour vous remercier."
          }
        }
      }
    },
    "quest.friendship-062": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell [person] about something you're struggling with and let them respond instead of pretending everything is always fine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntale a [person] sobre algo con lo que estás luchando y déjale responder en lugar de pretender que todo siempre está bien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl [person] von etwas, mit dem Sie zu kämpfen haben, und lassen Sie sie antworten, anstatt so zu tun, als wäre immer alles in Ordnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à [person] de quelque chose avec lequel vous rencontrez des difficultés et laissez-la répondre au lieu de prétendre que tout va toujours bien."
          }
        }
      }
    },
    "quest.friendship-063": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend what they want more of in their social life this year and ask how you can support that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a qué quiere más en su vida social este año y pregunta cómo puedes apoyar eso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, wovon er sich dieses Jahr mehr in seinem sozialen Leben wünscht, und frag, wie Sie dies unterstützen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami ce qu’il souhaite de plus dans sa vie sociale cette année et demandez-lui comment vous pouvez soutenir cela."
          }
        }
      }
    },
    "quest.friendship-064": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a chill at-home night such as cooking together, takeout plus movie, or shared music session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una noche relajada en casa como cocinar juntos, comida para llevar más película o sesión de música compartida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem entspannten Abend zu Hause ein, z. B. zu gemeinsamem Kochen, Essen zum Mitnehmen und Filmen oder einer gemeinsamen Musiksession."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à une soirée décontractée à la maison, comme cuisiner ensemble, emporter un film ou une séance de musique partagée."
          }
        }
      }
    },
    "quest.friendship-065": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone you see regularly at the gym, café, or bus stop one extra question that moves the conversation past small talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazle a alguien que ves regularmente en el gimnasio, café o parada de autobús una pregunta extra que mueva la conversación más allá de la charla superficial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell jemandem, den Sie regelmäßig im Fitnessstudio, Café oder an der Bushaltestelle treffen, eine zusätzliche Frage, die das Gespräch über Smalltalk hinausführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez à quelqu'un que vous voyez régulièrement à la salle de sport, au café ou à l'arrêt de bus une question supplémentaire qui fera passer la conversation au-delà des bavardages."
          }
        }
      }
    },
    "quest.friendship-066": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to help you with something small such as giving feedback or trying a prototype, and make it clear there's no pressure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a ayudarte con algo pequeño como dar retroalimentación o probar un prototipo, y deja claro que no hay presión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte [person], Ihnen bei kleinen Dingen zu helfen, z. B. Feedback zu geben oder einen Prototyp auszuprobieren, und mach deutlich, dass es keinen Druck gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à vous aider avec quelque chose de petit, comme donner son avis ou essayer un prototype, et dites clairement qu'il n'y a aucune pression."
          }
        }
      }
    },
    "quest.friendship-067": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send 5 quick check-in messages to people in different parts of your life such as work, school, hometown, and online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía 5 mensajes rápidos de seguimiento a personas en diferentes partes de tu vida como trabajo, escuela, ciudad natal y en línea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende 5 schnelle Check-in-Nachrichten an Menschen in verschiedenen Bereichen Ihres Lebens, z. B. bei der Arbeit, in der Schule, in Ihrer Heimatstadt und online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez 5 messages d'enregistrement rapide à des personnes dans différentes parties de votre vie, comme le travail, l'école, votre ville natale et en ligne."
          }
        }
      }
    },
    "quest.friendship-068": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask [person] if they want to join you in a mini challenge such as a week of walks, a reading challenge, or daily check-ins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a [person] si quiere unirse a un mini reto contigo como una semana de caminatas, un reto de lectura o check-ins diarios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag [person], ob sie an einer Mini-Challenge teilnehmen möchte, z. B. an einer Woche Spaziergänge, einer Lese-Challenge oder täglichen Check-ins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à [person] si elle souhaite vous rejoindre dans un mini-défi comme une semaine de promenades, un défi de lecture ou des enregistrements quotidiens."
          }
        }
      }
    },
    "quest.friendship-069": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell someone, out loud, that you're glad they're in your life and watch their reaction without deflecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a alguien, en voz alta, que estás feliz de que esté en tu vida y observa su reacción sin desviar el tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag jemandem laut, dass Sie froh sind, dass er in Ihrem Leben ist, und beobachte seine Reaktion, ohne abzulenken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à quelqu'un à voix haute que vous êtes heureux qu'il soit dans votre vie et observez sa réaction sans vous détourner."
          }
        }
      }
    },
    "quest.friendship-070": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to come sit with you somewhere scenic such as a river, rooftop, or hill for at least 30 minutes of talking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a sentarse contigo en algún lugar escénico como un río, azotea o colina por al menos 30 minutos de conversación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, sich mit Ihnen an einen malerischen Ort wie einen Fluss, ein Dach oder einen Hügel zu setzen und sich mindestens 30 Minuten lang zu unterhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à venir s'asseoir avec vous dans un endroit pittoresque, comme une rivière, un toit ou une colline, pendant au moins 30 minutes de conversation."
          }
        }
      }
    },
    "quest.friendship-071": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if there's a show, movie, or game they want to share with you and let them pick for one night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si hay una serie, película o juego que quiera compartir contigo y déjale elegir por una noche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob er eine Show, einen Film oder ein Spiel mit Ihnen teilen möchte, und lassen Sie ihn für einen Abend auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami s'il souhaite partager une émission, un film ou un jeu avec vous et laissez-le choisir pour une soirée."
          }
        }
      }
    },
    "quest.friendship-072": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to \"run an outside mission\" with you such as a Walmart run, mall browse, or late-night snack trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a \"hacer una misión afuera\" contigo como ir a una tienda, pasear por el centro comercial o un viaje nocturno por snacks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, mit Ihnen eine „externe Mission“ durchzuführen, z. B. einen Walmart-Lauf, einen Einkaufsbummel oder einen nächtlichen Snack-Ausflug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à « mener une mission extérieure » avec vous, comme une course Walmart, une visite dans un centre commercial ou une sortie collation de fin de soirée."
          }
        }
      }
    },
    "quest.friendship-073": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone in your life what kind of friend they want to be better at being and share your own answer too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien en tu vida qué tipo de amigo/a quiere ser mejor y comparte tu propia respuesta también."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden in Ihrem Leben, welche Art von Freund er besser sein möchte, und teile auch Ihre eigene Antwort mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un dans votre vie quel genre d'ami il aimerait devenir meilleur et partagez également votre propre réponse."
          }
        }
      }
    },
    "quest.friendship-074": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to meet you halfway between both of your places for a neutral spot hang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a encontrarse a mitad de camino entre sus lugares para una reunión en un lugar neutral."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, sich auf halbem Weg zwischen Ihren beiden Orten mit Ihnen zu treffen, um an einem neutralen Ort aufzuhängen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à vous rencontrer à mi-chemin entre vos deux endroits pour un rendez-vous neutre."
          }
        }
      }
    },
    "quest.friendship-075": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend from a long time ago what they remember most about the time you spent together back then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a de hace mucho tiempo qué es lo que más recuerda del tiempo que pasaron juntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund von vor langer Zeit, woran er sich aus der Zeit, die Sie damals zusammen verbracht haben, am meisten erinnert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami d’il y a longtemps ce dont il se souvient le plus du temps que vous avez passé ensemble à l’époque."
          }
        }
      }
    },
    "quest.friendship-076": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a new spot you've never tried such as a café, bar, park, or late-night food place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a un lugar nuevo que nunca hayas probado como un café, bar, parque o lugar de comida nocturno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] an einen neuen Ort ein, den Sie noch nie besucht haben, z. B. ein Café, eine Bar, einen Park oder einen Ort, an dem Sie bis spät in die Nacht essen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] dans un nouvel endroit que vous n'avez jamais essayé, comme un café, un bar, un parc ou un lieu de restauration ouvert tard le soir."
          }
        }
      }
    },
    "quest.friendship-077": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone at an event or meetup what made them decide to show up tonight and share your reason too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien en un evento o meetup qué le hizo decidir venir esta noche y comparte tu razón también."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden bei einer Veranstaltung oder einem Treffen, warum er sich entschieden hat, heute Abend hier zu sein, und teile auch Ihre Gründe mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un lors d'un événement ou d'une rencontre ce qui l'a poussé à décider de se présenter ce soir et partagez également votre raison."
          }
        }
      }
    },
    "quest.friendship-078": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to bring one of their friends you don't know and meet all together for a chill hang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a traer a uno de sus amigos que no conoces y reúnanse todos para una reunión relajada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, einen ihrer Freunde, die Sie nicht kennen, mitzubringen und sich alle zu einem entspannten Hang zu treffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à amener un de ses amis que vous ne connaissez pas et à vous retrouver tous ensemble pour une soirée détente."
          }
        }
      }
    },
    "quest.friendship-079": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend what they want their life to look like in 5 years and ask at least two follow-up questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a cómo quiere que sea su vida en 5 años y haz al menos dos preguntas de seguimiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, wie sein Leben in fünf Jahren aussehen soll, und stell mindestens zwei Folgefragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami à quoi il veut que sa vie ressemble dans 5 ans et posez au moins deux questions de suivi."
          }
        }
      }
    },
    "quest.friendship-080": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a \"focused work + chill after\" hang where you both work for an hour then hang for at least 20 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una reunión de \"trabajo enfocado + relax después\" donde ambos trabajen una hora y luego pasen al menos 20 minutos juntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem „Konzentriertes Arbeiten + Entspannen danach“-Hang ein, bei dem Sie beide eine Stunde lang arbeiten und dann mindestens 20 Minuten lang hängen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à une séance « travail concentré + détente après » où vous travaillez tous les deux pendant une heure, puis restez pendant au moins 20 minutes."
          }
        }
      }
    },
    "quest.friendship-081": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell someone they can call or text you anytime about something specific such as breakups, creative blocks, or job stress—and mean it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a alguien que puede llamarte o escribirte en cualquier momento sobre algo específico como rupturas, bloqueos creativos o estrés laboral—y sé sincero/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag jemandem, dass er Sie jederzeit anrufen oder Ihnen eine SMS schicken kann, wenn es um etwas Bestimmtes wie Trennungen, kreative Blockaden oder Arbeitsstress geht – und meinen Sie es ernst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à quelqu'un qu'il peut vous appeler ou vous envoyer un SMS à tout moment à propos de quelque chose de spécifique, comme des ruptures, des blocages créatifs ou le stress au travail, et pensez-le."
          }
        }
      }
    },
    "quest.friendship-082": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a \"bring your own drink\" balcony, porch, or parking-lot conversation for at least 30 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una conversación de \"trae tu propia bebida\" en balcón, porche o estacionamiento por al menos 30 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] für mindestens 30 Minuten zu einem „Bring Ihr eigenes Getränk mit“-Gespräch auf dem Balkon, der Veranda oder auf dem Parkplatz ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à une conversation « apportez votre propre boisson » sur un balcon, un porche ou un parking pendant au moins 30 minutes."
          }
        }
      }
    },
    "quest.friendship-083": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend what they feel they can't really talk to most people about and see if they want to share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a qué siente que no puede hablar realmente con la mayoría de personas y ve si quiere compartir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, worüber er seiner Meinung nach mit den meisten Menschen nicht wirklich sprechen kann, und prüfe, ob er es mitteilen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami ce dont il pense qu'il ne peut pas vraiment parler à la plupart des gens et voyez s'il souhaite le partager."
          }
        }
      }
    },
    "quest.friendship-084": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to attend a live event with you such as a show, open mic, sports game, or local performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a asistir a un evento en vivo contigo como un show, micrófono abierto, partido deportivo o presentación local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, mit Ihnen an einer Live-Veranstaltung teilzunehmen, z. B. an einer Show, einem Open Mic, einem Sportspiel oder einer lokalen Aufführung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à assister à un événement en direct avec vous, comme un spectacle, un micro ouvert, un match sportif ou un spectacle local."
          }
        }
      }
    },
    "quest.friendship-085": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone whose hustle or creativity you respect if they'd be down to swap notes over coffee or a call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien cuya dedicación o creatividad respetas si le gustaría intercambiar ideas tomando un café o en una llamada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, dessen Hektik oder Kreativität Sie respektieren, ob er bereit wäre, bei einem Kaffee oder einem Anruf Notizen auszutauschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un dont vous respectez l'enthousiasme ou la créativité s'il serait prêt à échanger des notes autour d'un café ou d'un appel."
          }
        }
      }
    },
    "quest.friendship-086": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to do a late-night drive or public transport ride with you to just talk and look at the city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a dar un paseo nocturno en auto o transporte público contigo solo para hablar y ver la ciudad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einer nächtlichen Autofahrt oder Fahrt mit öffentlichen Verkehrsmitteln ein, um einfach nur zu reden und sich die Stadt anzuschauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à faire une promenade nocturne en voiture ou en transports en commun avec vous pour simplement parler et regarder la ville."
          }
        }
      }
    },
    "quest.friendship-087": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if you can vent about something for 5 minutes and then ask them if they want to vent about anything too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si puedes desahogarte sobre algo por 5 minutos y luego pregúntale si quiere desahogarse de algo también."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, ob Sie fünf Minuten lang etwas auslassen können, und frag ihn dann, ob er auch etwas auslassen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami si vous pouvez vous exprimer sur quelque chose pendant 5 minutes, puis demandez-lui s'il souhaite également s'exprimer sur quelque chose."
          }
        }
      }
    },
    "quest.friendship-088": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a grocery-store or market mission where the goal is to find one new snack or drink to try together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una misión al supermercado o mercado donde el objetivo sea encontrar un nuevo snack o bebida para probar juntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem Lebensmittelgeschäft oder einer Marktmission ein, bei der das Ziel darin besteht, einen neuen Snack oder ein neues Getränk zu finden, das Sie gemeinsam probieren können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à une mission dans une épicerie ou un marché où le but est de trouver une nouvelle collation ou une nouvelle boisson à essayer ensemble."
          }
        }
      }
    },
    "quest.friendship-089": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what friendship means to them and share one thing you wish more people knew about how to be your friend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien qué significa la amistad para él/ella y comparte una cosa que desearías que más personas supieran sobre cómo ser tu amigo/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was Freundschaft für ihn bedeutet, und teile etwas mit, von dem Sie sich wünschen, dass mehr Menschen wissen, wie man mit Ihnen befreundet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un ce que l'amitié signifie pour lui et partagez une chose que vous souhaiteriez que plus de gens sachent sur la façon d'être votre ami."
          }
        }
      }
    },
    "quest.friendship-090": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to a \"phones away for 20 minutes\" conversation where you both put your phones face down and just talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a una conversación de \"teléfonos guardados por 20 minutos\" donde ambos pongan sus teléfonos boca abajo y solo hablen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] zu einem „20-Minuten-Telefon weg“-Gespräch ein, bei dem Sie beide Ihre Telefone verdeckt hinlegen und einfach reden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à une conversation « sans téléphone pendant 20 minutes » au cours de laquelle vous posez tous les deux vos téléphones face cachée et parlez simplement."
          }
        }
      }
    },
    "quest.friendship-091": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend what they think your strengths are as a person and let them talk without arguing against it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a qué cree que son tus fortalezas como persona y déjale hablar sin argumentar en contra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Freund, was Ihrer Meinung nach Ihre Stärken als Person sind, und lassen Sie ihn reden, ohne dagegen zu argumentieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ami quelles sont, selon lui, vos forces en tant que personne et laissez-le parler sans argumenter contre cela."
          }
        }
      }
    },
    "quest.friendship-092": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite [person] to join you in trying a new low-stakes hobby together such as sketching at a café, journaling, or photography walk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a [person] a probar un nuevo hobby de bajo riesgo juntos como dibujar en un café, escribir un diario o caminata fotográfica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade [person] ein, mit Ihnen gemeinsam ein neues Hobby mit geringem Einsatz auszuprobieren, z. B. Zeichnen in einem Café, Tagebuch schreiben oder einen Fotospaziergang machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez [person] à vous rejoindre pour essayer ensemble un nouveau passe-temps à faibles enjeux, comme dessiner dans un café, tenir un journal ou faire une promenade photographique."
          }
        }
      }
    },
    "quest.friendship-093": {
      "extractionState": "stale",
      "localizations": {
        "en": {
