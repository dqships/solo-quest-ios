    },
    "quest.friendship-014": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply to 5 people's stories or posts today with something more meaningful than an emoji."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a las historias o publicaciones de 5 personas hoy con algo más significativo que un emoji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte heute auf die Geschichten oder Beiträge von 5 Personen mit etwas Bedeutsamerem als einem Emoji."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
