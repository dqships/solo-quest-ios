    },
    "quest.adventure-050": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a scooter, bike, or just walk and follow a river, railway, or main road for at least 20 minutes in one direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un scooter, bicicleta o simplemente camina y sigue un río, vía de tren o carretera principal durante al menos 20 minutos en una dirección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Roller, ein Fahrrad oder geh einfach zu Fuß und folgen Sie mindestens 20 Minuten lang einem Fluss, einer Eisenbahn oder einer Hauptstraße in eine Richtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un scooter, un vélo ou marchez simplement et suivez une rivière, une voie ferrée ou une route principale pendant au moins 20 minutes dans une direction."
          }
