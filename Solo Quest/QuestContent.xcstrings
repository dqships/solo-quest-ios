        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolviere eine 45-minütige Yoga-Sitzung mit aktiven Posen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez une séance de yoga de 45 minutes avec des poses actives."
          }
        }
      }
    },
    "quest.stamina-zumba-class": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend a Zumba or dance fitness class and complete the full session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiste a una clase de Zumba o fitness de baile y completa la sesión completa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm an einem Zumba- oder Tanz-Fitnesskurs teil und absolviere die gesamte Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
