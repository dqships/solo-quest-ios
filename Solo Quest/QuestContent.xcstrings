            "state": "translated",
            "value": "Envoyez un compliment sincère et spécifique à 3 personnes que vous connaissez déjà, concernant leur travail, leur personnalité ou leur évolution."
          }
        }
      }
    },
    "quest.friendship-009": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask [person] if they want to cowork or study together for an hour at a café, library, or your place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
