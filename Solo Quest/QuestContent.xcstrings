          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag [person], ob sie eine Stunde lang in einem Café, einer Bibliothek oder bei Ihnen zusammenarbeiten oder gemeinsam lernen möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à [person] si elle souhaite travailler ensemble ou étudier ensemble pendant une heure dans un café, une bibliothèque ou chez vous."
          }
        }
      }
    },
    "quest.friendship-010": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host a tiny hang: invite at least 1 person over for a low-pressure chill night such as game, movie, or music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza una pequeña reunión: invita al menos a 1 persona para una noche relajada de juegos, película o música."
