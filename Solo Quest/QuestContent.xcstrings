        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Wahrzeichen, eine Statue oder ein Wandgemälde aus und stell sich direkt daneben, anstatt einfach daran vorbeizugehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un point de repère, une statue ou une peinture murale et allez-y physiquement juste à côté au lieu de simplement passer par là."
          }
        }
      }
    },
    "quest.adventure-041": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a laundromat, arcade, or community center even if you don't need it and hang out for 15 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una lavandería, arcade o centro comunitario aunque no lo necesites y pasa el rato por 15 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in einen Waschsalon, eine Spielhalle oder ein Gemeindezentrum, auch wenn Sie es nicht brauchen, und bleib 15 Minuten dort."
          }
