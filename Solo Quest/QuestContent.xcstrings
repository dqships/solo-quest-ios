    "quest.adventure-015": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a long walk at golden hour specifically to find one spot you've never noticed that feels cinematic and take a photo there."
          }
        },
        "es": {
