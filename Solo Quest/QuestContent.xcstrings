          "stringUnit": {
            "state": "translated",
            "value": "Abordez quelqu'un que vous trouvez attirant et demandez-lui : « Opinion honnête : dois-je commander X ou Y ? puis suivez leur choix."
          }
        }
      }
    },
    "quest.rejection-093": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone what they do but then immediately follow up by asking what they'd do if money and time weren't a problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a alguien a qué se dedica pero luego inmediatamente haz seguimiento preguntando qué haría si el dinero y el tiempo no fueran un problema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, was er tut, und frag dann sofort, was er tun würde, wenn Geld und Zeit kein Problem wären."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à quelqu'un ce qu'il fait, puis demandez-lui immédiatement ce qu'il ferait si l'argent et le temps n'étaient pas un problème."
          }
        }
      }
    },
    "quest.rejection-094": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one week, attempt at least 3 clear invitations such as coffee, walk, or drink and write down how each one went afterward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una semana, intenta al menos 3 invitaciones claras como café, paseo o trago y escribe cómo fue cada una después."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere in einer Woche mindestens drei klare Einladungen wie Kaffee, Spaziergang oder Trinken aus und schreib auf, wie jede einzelne danach gelaufen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
