    },
    "quest.friendship-011": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a friend if they want to hit a grocery store or Target run together and treat it like a mini hang, not just an errand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a un amigo/a si quiere ir juntos al supermercado y trátalo como una mini salida, no solo un mandado."
          }
