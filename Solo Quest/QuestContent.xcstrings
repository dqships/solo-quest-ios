    "quest.friendship-018": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a long appreciation text to [person] explaining how they've impacted your life positively."
          }
        },
        "es": {
