    "quest.rejection-058": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone you find attractive a playful, low-stakes question such as \"pizza or tacos?\" and riff with their answer for at least 30 seconds."
          }
