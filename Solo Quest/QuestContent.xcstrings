        }
      }
    },
    "quest.adventure-048": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a café or food spot in a neighborhood you rarely visit and stay until you finish a full drink or meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un café o lugar de comida en un vecindario que rara vez visitas y quédate hasta terminar una bebida o comida completa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in einem Viertel, das Sie selten besuchen, in ein Café oder Essenslokal und bleib dort, bis Sie ein reichhaltiges Getränk oder eine Mahlzeit zu sich genommen haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans un café ou un restaurant dans un quartier que vous visitez rarement et restez jusqu'à ce que vous ayez fini un verre ou un repas complet."
