    },
    "quest.status-096": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk through a nightlife or busy area at night without headphones, just absorbing the energy like you're part of the city's main storyline."
          }
