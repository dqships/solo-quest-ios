    "quest.Stand-outside-your-home-and-look-at-it-like-a-stranger-noticing-all-the-details-for-5-minutes": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand outside your home and look at it like a stranger, noticing all the details for 5 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate afuera de tu casa y mírala como un extraño, notando todos los detalles por 5 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich vor Ihr Haus und betrachte es wie ein Fremder, wobei Sie fünf Minuten lang alle Details wahrnehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez-vous devant votre maison et regardez-la comme un étranger, en remarquant tous les détails pendant 5 minutes."
          }
        }
      }
    },
    "quest.status-001": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean your shoes thoroughly so they look as close to new as possible, then wear them out at least once this week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia tus zapatos a fondo para que se vean lo más nuevos posible, luego úsalos afuera al menos una vez esta semana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinige Ihre Schuhe gründlich, damit sie möglichst neu aussehen, und trage sie dann mindestens einmal in dieser Woche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez soigneusement vos chaussures pour qu'elles aient l'air aussi neuves que possible, puis portez-les au moins une fois cette semaine."
          }
        }
      }
    },
    "quest.status-002": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one outfit that makes you feel like the main character, iron/steam it, and wear it outside for at least an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un atuendo que te haga sentir como el personaje principal, plánchalo/vaporízalo, y úsalo afuera por al menos una hora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Outfit aus, bei dem Sie sich wie die Hauptfigur fühlen, bügeln/dämpfen Sie es und trage es mindestens eine Stunde lang draußen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une tenue qui vous donne l'impression d'être le personnage principal, repassez-la/vapeur et portez-la à l'extérieur pendant au moins une heure."
          }
        }
      }
    },
    "quest.status-003": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book a haircut or grooming appointment (or do a detailed self-groom at home) and go out in public afterward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda una cita para cortarte el pelo o arreglarte (o hazte un arreglo detallado en casa) y sal en público después."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereinbare einen Friseur- oder Pflegetermin (oder führe zu Hause eine ausführliche Selbstpflege durch) und geh anschließend in die Öffentlichkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réservez un rendez-vous pour une coupe de cheveux ou un toilettage (ou faites un auto-toilettage détaillé à la maison) et sortez ensuite en public."
          }
        }
      }
    },
    "quest.status-004": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand in front of a mirror and experiment with posture until you find a relaxed, tall stance, then practice walking like that for 10 minutes outside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate frente a un espejo y experimenta con la postura hasta encontrar una pose relajada y erguida, luego practica caminando así por 10 minutos afuera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich vor einen Spiegel und experimentieren Sie mit der Haltung, bis Sie eine entspannte, aufrechte Haltung gefunden haben. Übe dann 10 Minuten lang das Gehen auf diese Weise im Freien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez-vous devant un miroir et expérimentez la posture jusqu'à ce que vous trouviez une position détendue et haute, puis entraînez-vous à marcher ainsi pendant 10 minutes à l'extérieur."
          }
        }
      }
    },
    "quest.status-005": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declutter one visible surface in your living space such as a desk, dresser, or coffee table until it looks clean and intentional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despeja una superficie visible en tu espacio como un escritorio, cómoda o mesa de café hasta que se vea limpia e intencional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume eine sichtbare Oberfläche in Ihrem Wohnraum auf, beispielsweise einen Schreibtisch, eine Kommode oder einen Couchtisch, bis sie sauber und zweckmäßig aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désencombrez une surface visible de votre espace de vie, comme un bureau, une commode ou une table basse, jusqu'à ce qu'elle paraisse propre et intentionnelle."
          }
        }
      }
    },
    "quest.status-006": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy or repurpose one object that makes your room look more like an adult space such as a lamp, plant, or framed piece of art, and set it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra o reutiliza un objeto que haga tu cuarto verse más adulto como una lámpara, planta, o cuadro enmarcado, y colócalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf ein Objekt oder verwende es um, damit Ihr Zimmer eher wie ein Raum für Erwachsene aussieht, zum Beispiel eine Lampe, eine Pflanze oder ein gerahmtes Kunstwerk, und richten Sie es ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achetez ou réutilisez un objet qui donne à votre pièce l'apparence d'un espace pour adultes, comme une lampe, une plante ou une œuvre d'art encadrée, et installez-le."
          }
        }
      }
    },
    "quest.status-007": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash your sheets and pillowcases, make your bed hotel-style, and keep it made for a full day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava tus sábanas y fundas de almohada, tiende tu cama estilo hotel, y mantenla tendida por un día completo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasche Ihre Laken und Kissenbezüge, mach Ihr Bett im Hotelstil und lassen Sie es den ganzen Tag lang bezogen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavez vos draps et vos taies d'oreiller, faites de votre lit un style hôtelier et gardez-le fait pendant une journée complète."
          }
        }
      }
    },
    "quest.status-008": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a full skincare reset: wash, moisturize, and apply any products you have, then take a selfie you actually like on purpose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un reinicio completo de cuidado de piel: lava, hidrata, y aplica cualquier producto que tengas, luego tómate una selfie que realmente te guste a propósito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen kompletten Neustart Ihrer Hautpflege: Wasche Ihre Haut, spende Feuchtigkeit, trage alle verfügbaren Produkte auf und mach dann absichtlich ein Selfie, das Ihnen wirklich gefällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez une réinitialisation complète des soins de la peau : lavez, hydratez et appliquez tous les produits que vous avez, puis prenez volontairement un selfie que vous aimez vraiment."
          }
        }
      }
    },
    "quest.status-009": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go through your closet and pull out 5 items you never wear that make you feel low-status and bag them to donate or sell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu clóset y saca 5 prendas que nunca usas que te hacen sentir de bajo estatus y empácalas para donar o vender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh durch Ihren Kleiderschrank und holen Sie fünf Artikel heraus, die Sie nie tragen und die Ihnen das Gefühl geben, einen schlechten Status zu haben, und packe sie ein, um sie zu spenden oder zu verkaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez votre placard et sortez 5 articles que vous ne portez jamais et qui vous font vous sentir inférieur et mettez-les dans un sac pour les donner ou les vendre."
          }
        }
      }
    },
    "quest.status-010": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one scent as your signature for the week (body wash, cologne, lotion, etc.) and apply it intentionally before leaving home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un aroma como tu firma de la semana (jabón corporal, colonia, loción, etc.) y aplícalo intencionalmente antes de salir de casa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Duft als Ihr Markenzeichen für die Woche (Duschgel, Eau de Cologne, Lotion usw.) und trage ihn bewusst auf, bevor Sie das Haus verlassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un parfum comme signature de la semaine (gel douche, eau de Cologne, lotion, etc.) et appliquez-le intentionnellement avant de quitter la maison."
          }
        }
      }
    },
    "quest.status-011": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a high-end hotel lobby or nice building, walk in with confidence, sit for at least 15 minutes, and soak in the environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita el lobby de un hotel de lujo o un edificio bonito, entra con confianza, siéntate por al menos 15 minutos, y absorbe el ambiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuch die Lobby eines Luxushotels oder ein schönes Gebäude, geh selbstbewusst hinein, sitz mindestens 15 Minuten und genieße die Umgebung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitez le hall d’un hôtel haut de gamme ou un joli bâtiment, entrez en toute confiance, asseyez-vous pendant au moins 15 minutes et imprégnez-vous de l’environnement."
          }
        }
      }
    },
    "quest.status-012": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go alone to a nicer bar, lounge, or café than you usually frequent, sit or stand like you belong, and stay for at least 30 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve solo a un bar, lounge o café más elegante de lo que usualmente frecuentas, siéntate o párate como si pertenecieras, y quédate al menos 30 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh alleine in eine schönere Bar, Lounge oder ein Café, als Sie es normalerweise tun, sitzen oder steh, wie Sie dazugehören, und bleib mindestens 30 Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez seul dans un bar, un salon ou un café plus agréable que celui que vous fréquentez habituellement, asseyez-vous ou restez debout comme à votre place et restez au moins 30 minutes."
          }
        }
      }
    },
    "quest.status-013": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curate one \"status\" outfit by combining your best shoes, pants, and top and take 3 full-body photos in good lighting for reference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un atuendo de \"estatus\" combinando tus mejores zapatos, pantalones y parte superior y toma 3 fotos de cuerpo completo con buena iluminación como referencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell ein „Status“-Outfit zusammen, indem Sie Ihre besten Schuhe, Hosen und Oberteile kombinieren, und mach als Referenz drei Ganzkörperfotos bei guter Beleuchtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une tenue de « statut » en combinant vos plus belles chaussures, pantalons et haut et prenez 3 photos de tout le corps sous un bon éclairage pour référence."
          }
        }
      }
    },
    "quest.status-014": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean your bathroom mirror, sink, and toilet so they look guest-ready, even if no one is coming over today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia el espejo del baño, lavabo y sanitario para que estén listos para visitas, aunque nadie venga hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinige Ihren Badezimmerspiegel, Ihr Waschbecken und Ihre Toilette, damit sie für den Gast bereit aussehen, auch wenn heute niemand vorbeikommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez le miroir, le lavabo et les toilettes de votre salle de bain pour qu'ils aient l'air prêts à accueillir les invités, même si personne ne vient chez vous aujourd'hui."
          }
        }
      }
    },
    "quest.status-015": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a nice area of your city (downtown, waterfront, upscale neighborhood) and walk for at least 30 minutes imagining you already live there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una zona bonita de tu ciudad (centro, costa, barrio exclusivo) y camina por al menos 30 minutos imaginando que ya vives ahí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in eine schöne Gegend Ihrer Stadt (Innenstadt, Hafenviertel, gehobenes Viertel) und geh mindestens 30 Minuten zu Fuß in der Vorstellung, dass Sie bereits dort wohnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez-vous dans un quartier sympa de votre ville (centre-ville, front de mer, quartier chic) et marchez pendant au moins 30 minutes en imaginant que vous y habitez déjà."
          }
        }
      }
    },
    "quest.status-016": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy one high-quality basic such as a plain tee, belt, or socks that levels up your baseline outfits and wear it this week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra una prenda básica de alta calidad como una camiseta lisa, cinturón, o calcetines que mejore tus atuendos base y úsala esta semana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf ein hochwertiges Basic wie ein schlichtes T-Shirt, einen Gürtel oder Socken, das Ihr Grundoutfit aufwertet, und trage es diese Woche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achetez un basique de haute qualité comme un t-shirt uni, une ceinture ou des chaussettes qui rehausseront vos tenues de base et portez-le cette semaine."
          }
        }
      }
    },
    "quest.status-017": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a 20-minute posture workout focusing on back, core, and chest, then practice walking through a public place tall and relaxed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un entrenamiento de postura de 20 minutos enfocándote en espalda, core y pecho, luego practica caminando por un lugar público erguido y relajado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ein 20-minütiges Haltungstraining mit Schwerpunkt auf Rücken, Rumpf und Brust und übe dann, aufrecht und entspannt durch einen öffentlichen Ort zu gehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un entraînement de posture de 20 minutes en vous concentrant sur le dos, le tronc et la poitrine, puis entraînez-vous à marcher dans un lieu public en hauteur et détendu."
          }
        }
      }
    },
    "quest.status-018": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go through your phone and delete or hide apps from your home screen that make you feel low-status or drained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu teléfono y elimina u oculta apps de tu pantalla principal que te hagan sentir de bajo estatus o agotado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh Ihr Telefon durch und löschen oder verbergen Sie Apps von Ihrem Startbildschirm, die Ihnen das Gefühl geben, einen schlechten Status zu haben oder ausgelaugt zu sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez votre téléphone et supprimez ou masquez les applications de votre écran d'accueil qui vous font vous sentir déprimé ou épuisé."
          }
        }
      }
    },
    "quest.status-019": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a clean, intentional lockscreen and homescreen background that matches the future lifestyle you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un fondo de pantalla de bloqueo e inicio limpio e intencional que coincida con el estilo de vida futuro que quieres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg einen klaren, bewussten Sperrbildschirm- und Homescreen-Hintergrund fest, der zu Ihrem zukünftigen Lebensstil passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un écran de verrouillage et un arrière-plan d'écran d'accueil propres et intentionnels qui correspondent au style de vie futur que vous souhaitez."
          }
        }
      }
    },
    "quest.status-020": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit at the bar instead of a table at a restaurant or café at least once this week and order something confidently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la barra en lugar de una mesa en un restaurante o café al menos una vez esta semana y ordena algo con confianza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich in einem Restaurant oder Café mindestens einmal in dieser Woche an die Bar statt an einen Tisch und bestell selbstbewusst etwas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous au bar plutôt qu'à une table dans un restaurant ou un café au moins une fois cette semaine et commandez quelque chose en toute confiance."
          }
        }
      }
    },
    "quest.status-021": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 20 minutes improving the lighting in your room using lamps, bulbs, or windows so it feels more cinematic and less dingy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 20 minutos a mejorar la iluminación de tu cuarto usando lámparas, focos o ventanas para que se sienta más cinematográfico y menos apagado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 20 Minuten damit, die Beleuchtung in Ihrem Zimmer mit Lampen, Glühbirnen oder Fenstern zu verbessern, damit es filmischer und weniger schmuddelig wirkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 20 minutes à améliorer l'éclairage de votre pièce à l'aide de lampes, d'ampoules ou de fenêtres pour qu'elle soit plus cinématographique et moins sombre."
          }
        }
      }
    },
    "quest.status-022": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take public transport, Uber, or drive to a part of town you associate with success and sit there journaling for 10 minutes about your future self."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma transporte público, Uber, o conduce a una parte de la ciudad que asocias con éxito y siéntate ahí escribiendo en tu diario por 10 minutos sobre tu yo futuro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm öffentliche Verkehrsmittel, Uber oder fahr in einen Teil der Stadt, den Sie mit Erfolg assoziieren, und sitz dort und schreib 10 Minuten lang ein Tagebuch über Ihr zukünftiges Ich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez les transports en commun, Uber ou conduisez jusqu'à une partie de la ville que vous associez au succès et asseyez-vous là en écrivant pendant 10 minutes sur votre futur moi."
          }
        }
      }
    },
    "quest.status-023": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a detailed beard, facial hair, or eyebrow clean-up (or equivalent grooming) and look at yourself afterward as if you were your own stylist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una limpieza detallada de barba, vello facial o cejas (o arreglo equivalente) y mírate después como si fueras tu propio estilista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe eine detaillierte Bart-, Gesichtshaar- oder Augenbrauenreinigung (oder eine gleichwertige Pflege) durch und betrachte sich danach, als wären Sie Ihr eigener Stylist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez un nettoyage détaillé de la barbe, des poils du visage ou des sourcils (ou un toilettage équivalent) et regardez-vous ensuite comme si vous étiez votre propre styliste."
          }
        }
      }
    },
    "quest.status-024": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throw away or retire any underwear or socks with holes or stains and commit to only wearing pairs you'd be fine being seen in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira o retira cualquier ropa interior o calcetines con agujeros o manchas y comprométete a usar solo pares que no te avergonzaría que vieran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf Unterwäsche oder Socken mit Löchern oder Flecken weg oder entsorgen Sie sie und verpflichten Sie sich, nur Paare zu tragen, in denen Sie gut gesehen werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetez ou retirez tous les sous-vêtements ou chaussettes troués ou tachés et engagez-vous à ne porter que des paires dans lesquelles vous seriez bien vu."
          }
        }
      }
    },
    "quest.status-025": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one café, bar, or restaurant as your \"regular\" spot and go there twice in a month, treating staff with respect and eye contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un café, bar o restaurante como tu lugar \"regular\" y ve ahí dos veces en un mes, tratando al personal con respeto y contacto visual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such sich ein Café, eine Bar oder ein Restaurant als Ihren „Stammplatz“ aus und geh zweimal im Monat dorthin. Behandeln Sie das Personal mit Respekt und Augenkontakt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un café, un bar ou un restaurant comme endroit « habituel » et allez-y deux fois par mois, en traitant le personnel avec respect et en le regardant dans les yeux."
          }
        }
      }
    },
    "quest.status-026": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 30 minutes cleaning your car interior or the main area you use to travel so it feels like a higher-status ride."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 30 minutos a limpiar el interior de tu auto o el área principal que usas para viajar para que se sienta como un viaje de mayor estatus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 30 Minuten damit, den Innenraum Ihres Autos oder den Hauptbereich, den Sie zum Reisen nutzen, zu reinigen, damit es sich wie eine Fahrt mit höherem Status anfühlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 30 minutes à nettoyer l’intérieur de votre voiture ou la zone principale que vous utilisez pour voyager afin de donner l’impression d’un trajet de statut supérieur."
          }
        }
      }
    },
    "quest.status-027": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order one drink or food item you've never tried at a nicer spot and enjoy it slowly without your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena una bebida o comida que nunca hayas probado en un lugar más elegante y disfrútala lentamente sin tu teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestell ein Getränk oder Essen, das Sie noch nie probiert haben, an einem schöneren Ort und genieße es langsam ohne Ihr Telefon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandez une boisson ou un aliment que vous n'avez jamais essayé dans un endroit plus agréable et dégustez-le lentement sans votre téléphone."
          }
        }
      }
    },
    "quest.status-028": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into a clothing store you feel is slightly out of your price range, try on one item, and look at yourself in the mirror like you belong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra a una tienda de ropa que sientas está ligeramente fuera de tu rango de precio, pruébate una prenda, y mírate en el espejo como si pertenecieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in ein Bekleidungsgeschäft, das Ihrer Meinung nach etwas außerhalb Ihrer Preisspanne liegt, probiere einen Artikel an und betrachte sich im Spiegel, als ob Sie dazugehören würden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez dans un magasin de vêtements qui vous semble légèrement hors de votre fourchette de prix, essayez un article et regardez-vous dans le miroir comme si vous apparteniez à ce magasin."
          }
        }
      }
    },
    "quest.status-029": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one pair of pants and get them hemmed or tailored (or at least pinned for future tailoring) so they fit your body better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un par de pantalones y mándalos a ajustar o dobladillar (o al menos márcalos para ajuste futuro) para que te queden mejor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Hose aus und lassen Sie sie säumen oder zuschneiden (oder zumindest für zukünftige Schneiderarbeiten feststecken), damit sie besser zu Ihrem Körper passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un pantalon et faites-le ourler ou sur mesure (ou au moins épinglé pour une future confection) afin qu'il s'adapte mieux à votre corps."
          }
        }
      }
    },
    "quest.status-030": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a 15-minute \"status walk\" through a nice area listening to a song that makes you feel like the main character, and stay off your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una \"caminata de estatus\" de 15 minutos por una zona bonita escuchando una canción que te haga sentir como el personaje principal, y no uses tu teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen 15-minütigen „Status-Spaziergang“ durch eine schöne Gegend und hör sich ein Lied an, bei dem Sie sich wie die Hauptfigur fühlen, und bleib vom Telefon fern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une « marche de statut » de 15 minutes dans un endroit agréable en écoutant une chanson qui vous fait sentir comme le personnage principal et restez loin de votre téléphone."
          }
        }
      }
    },
    "quest.status-031": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize your wallet, bag, or everyday carry so everything looks intentional and not chaotic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza tu cartera, bolsa o artículos de uso diario para que todo se vea intencional y no caótico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisiere Ihr Portemonnaie, Ihre Tasche oder Ihre Alltagsgegenstände so, dass alles gewollt und nicht chaotisch aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez votre portefeuille, votre sac ou votre bagage quotidien pour que tout semble intentionnel et non chaotique."
          }
        }
      }
    },
    "quest.status-032": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a simple tray, bowl, or hook where your keys, wallet, and daily items live so you stop losing them and move smoother."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una bandeja, tazón o gancho simple donde vivan tus llaves, cartera y artículos diarios para dejar de perderlos y moverte más fluido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell ein einfaches Tablett, eine Schüssel oder einen Haken dort auf, wo Ihre Schlüssel, Ihr Portemonnaie und Ihre Alltagsgegenstände aufbewahrt werden, damit Sie sie nicht verlieren und sich reibungsloser bewegen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un simple plateau, un bol ou un crochet où se trouvent vos clés, votre portefeuille et vos objets du quotidien afin de ne plus les perdre et de vous déplacer plus facilement."
          }
        }
      }
    },
    "quest.status-033": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a rooftop, parking garage, or overlook with a good view of your city and spend 10 minutes just standing there as if it's your territory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una azotea, estacionamiento o mirador con buena vista de tu ciudad y pasa 10 minutos simplemente parado ahí como si fuera tu territorio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh auf ein Dach, ein Parkhaus oder einen Aussichtspunkt mit guter Aussicht auf Ihre Stadt und verbringe 10 Minuten dort, als wäre es Ihr Revier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez à un toit, à un parking ou à une vue panoramique sur votre ville et passez 10 minutes debout comme si c'était votre territoire."
          }
        }
      }
    },
    "quest.status-034": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a 10-minute cold shower or finishing cold rinse and step out like someone who can handle discomfort on purpose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una ducha fría de 10 minutos o un enjuague frío final y sal como alguien que puede manejar la incomodidad a propósito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm eine 10-minütige kalte Dusche oder eine abschließende Kaltspülung und geh wie jemand vor, der absichtlich mit Beschwerden umgehen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une douche froide de 10 minutes ou terminez un rinçage à l'eau froide et sortez comme quelqu'un qui peut volontairement gérer l'inconfort."
          }
        }
      }
    },
    "quest.status-035": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book or schedule a basic health maintenance move you've been avoiding such as a dentist, doctor, or eye appointment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda una cita básica de mantenimiento de salud que has estado evitando como dentista, doctor u oculista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchen oder vereinbare einen Termin für eine grundlegende Maßnahme zur Erhaltung Ihrer Gesundheit, die Sie bisher gemieden haben, beispielsweise einen Zahnarzt-, Arzt- oder Augenarztbesuch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réservez ou planifiez un déménagement de base pour le maintien de votre santé que vous avez évité, comme un rendez-vous chez le dentiste, le médecin ou la vue."
          }
        }
      }
    },
    "quest.status-036": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat one meal at a place with real plates and real silverware (no fast food) while sitting up straight and taking your time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Come una comida en un lugar con platos y cubiertos reales (nada de comida rápida) mientras te sientas derecho y tomas tu tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iss eine Mahlzeit an einem Ort mit echten Tellern und echtem Besteck (kein Fast Food), sitz dabei aufrecht und nimm sich Zeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangez un repas dans un endroit avec de vraies assiettes et de vrais couverts (pas de restauration rapide) en étant assis droit et en prenant votre temps."
          }
        }
      }
    },
    "quest.status-037": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 20 minutes curating a playlist that makes you feel like your higher self and use it for your next solo mission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 20 minutos a curar una playlist que te haga sentir como tu mejor versión y úsala para tu próxima misión en solitario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 20 Minuten damit, eine Playlist zusammenzustellen, die Ihnen das Gefühl gibt, Ihr höheres Selbst zu sein, und nutze sie für Ihre nächste Solo-Mission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 20 minutes à créer une liste de lecture qui vous fait sentir comme votre moi supérieur et utilisez-la pour votre prochaine mission solo."
          }
        }
      }
    },
    "quest.status-038": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a full room reset: pick up clothes, throw away trash, and make the floor clear enough to pace and think like a mastermind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un reinicio completo de tu cuarto: recoge ropa, tira basura, y deja el piso suficientemente despejado para caminar y pensar como un genio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe einen kompletten Raum-Reset durch: Sammle Kleidung ein, wirf Müll weg und sorgen Sie dafür, dass der Boden frei genug ist, damit Sie auf und ab gehen und wie ein Mastermind denken können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez une réinitialisation complète de la pièce : ramassez les vêtements, jetez les déchets et rendez le sol suffisamment dégagé pour pouvoir faire les cent pas et penser comme un cerveau."
          }
        }
      }
    },
    "quest.status-039": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go alone to a daytime café or brunch spot, sit at a table or bar, and stay long enough to finish a drink or meal without hiding in your phone the whole time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve solo a un café o lugar de brunch de día, siéntate en una mesa o barra, y quédate suficiente tiempo para terminar una bebida o comida sin esconderte en tu teléfono todo el tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh alleine in ein Tagescafé oder einen Brunch-Ort, setz sich an einen Tisch oder eine Bar und bleib lange genug, um einen Drink oder eine Mahlzeit zu sich zu nehmen, ohne sich die ganze Zeit in Ihrem Telefon zu verstecken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez seul dans un café ou un brunch en journée, asseyez-vous à une table ou un bar et restez assez longtemps pour finir un verre ou un repas sans vous cacher tout le temps dans votre téléphone."
          }
        }
      }
    },
    "quest.status-040": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one pair of shoes and clean the laces or replace them entirely so they look intentional and fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un par de zapatos y limpia las agujetas o reemplázalas por completo para que se vean intencionales y frescos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Paar Schuhe aus und reinige die Schnürsenkel oder tauschen Sie sie komplett aus, damit sie gewollt und frisch aussehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une paire de chaussures et nettoyez les lacets ou remplacez-les entièrement pour qu'ils aient l'air intentionnels et frais."
          }
        }
      }
    },
    "quest.status-041": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk through a luxury mall or high-end retail street and make eye contact with staff as you pass, like you could buy something if you wanted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina por un centro comercial de lujo o calle de tiendas exclusivas y haz contacto visual con el personal al pasar, como si pudieras comprar algo si quisieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh durch ein Luxus-Einkaufszentrum oder eine Luxuseinkaufsstraße und stell im Vorbeigehen Blickkontakt mit den Mitarbeitern her, als könnten Sie etwas kaufen, wenn Sie möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promenez-vous dans un centre commercial de luxe ou dans une rue commerçante haut de gamme et établissez un contact visuel avec le personnel en passant, comme si vous pouviez acheter quelque chose si vous le vouliez."
          }
        }
      }
    },
    "quest.status-042": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean or organize one drawer, shelf, or small area where you keep grooming products so it looks like a curated setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia u organiza un cajón, estante o área pequeña donde guardas productos de arreglo personal para que se vea como un set curado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinigen oder organisiere eine Schublade, ein Regal oder einen kleinen Bereich, in dem Sie Pflegeprodukte aufbewahren, damit es wie eine kuratierte Einrichtung aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez ou organisez un tiroir, une étagère ou une petite zone où vous conservez les produits de soins afin qu'ils ressemblent à une configuration organisée."
          }
        }
      }
    },
    "quest.status-043": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a solo night walk through a well-lit, safe area where people are out and about and move like you're exactly where you're supposed to be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da una caminata nocturna solo por un área bien iluminada y segura donde hay gente afuera y muévete como si estuvieras exactamente donde debes estar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen alleinigen Nachtspaziergang durch einen gut beleuchteten, sicheren Bereich, in dem sich Menschen aufhalten, und bewege sich, als wären Sie genau dort, wo Sie sein sollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une promenade nocturne en solo dans une zone bien éclairée et sûre où les gens sont dehors et bougez comme si vous étiez exactement là où vous êtes censé être."
          }
        }
      }
    },
    "quest.status-044": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At a café or restaurant, ask the staff for a recommendation and confidently order their suggestion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un café o restaurante, pide una recomendación al personal y ordena con confianza su sugerencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte in einem Café oder Restaurant das Personal um eine Empfehlung und bestell selbstbewusst seinen Vorschlag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un café ou un restaurant, demandez conseil au personnel et commandez en toute confiance sa suggestion."
          }
        }
      }
    },
    "quest.status-045": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 15 minutes grooming your hands and nails so they would not embarrass you if someone important noticed them closely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 15 minutos a arreglar tus manos y uñas para que no te avergüencen si alguien importante las notara de cerca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 15 Minuten damit, Ihre Hände und Nägel zu pflegen, damit Sie nicht in Verlegenheit geraten, wenn jemand Wichtiges sie genau bemerkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 15 minutes à soigner vos mains et vos ongles afin qu'ils ne vous embarrassent pas si quelqu'un d'important les remarquait de près."
          }
        }
      }
    },
    "quest.status-046": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one main jacket, coat, or outer layer and lint-roll, clean, or repair it so it always looks sharp when you leave the house."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una chaqueta, abrigo o capa exterior principal y quítale pelusa, límpiala o repárala para que siempre se vea impecable cuando salgas de casa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Hauptjacke, einen Mantel oder eine Außenschicht und rollen Sie sie mit Fusseln ab, reinige sie oder reparieren Sie sie, damit sie immer gut aussieht, wenn Sie das Haus verlassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une veste principale, un manteau ou une couche extérieure et un rouleau anti-peluches, nettoyez-le ou réparez-le pour qu'il ait toujours l'air net lorsque vous quittez la maison."
          }
        }
      }
    },
    "quest.status-047": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in a hotel lobby, upscale café, or co-working space and do 20 minutes of focused work or planning like someone whose time matters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en el lobby de un hotel, café elegante o espacio de coworking y haz 20 minutos de trabajo o planificación enfocada como alguien cuyo tiempo importa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich in die Lobby eines Hotels, in ein gehobenes Café oder in einen Co-Working-Bereich und erledige 20 Minuten konzentrierte Arbeit oder Planung wie jemand, dem Zeit wichtig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous dans le hall d'un hôtel, dans un café haut de gamme ou dans un espace de coworking et effectuez 20 minutes de travail ciblé ou de planification comme quelqu'un dont le temps compte."
          }
        }
      }
    },
    "quest.status-048": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a store that sells watches, jewelry, or accessories and try on at least one piece that makes you feel high-status, with no obligation to buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una tienda que venda relojes, joyería o accesorios y pruébate al menos una pieza que te haga sentir de alto estatus, sin obligación de comprar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in ein Geschäft, das Uhren, Schmuck oder Accessoires verkauft, und probiere mindestens ein Stück an, das Ihnen das Gefühl gibt, einen hohen Stellenwert zu haben, ohne dass Sie zum Kauf verpflichtet sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez-vous dans un magasin qui vend des montres, des bijoux ou des accessoires et essayez au moins une pièce qui vous donne le sentiment d'un statut élevé, sans obligation d'achat."
          }
        }
      }
    },
    "quest.status-049": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take 10 full steps into any room or street with your phone in your pocket, shoulders back, and eyes up, scanning like a leader, not a background character."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 10 pasos completos en cualquier habitación o calle con tu teléfono en el bolsillo, hombros hacia atrás, y ojos arriba, escaneando como un líder, no un personaje de fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh mit Ihrem Telefon in der Tasche, den Schultern nach hinten und den Augen nach oben 10 volle Schritte in jeden Raum oder jede Straße und scannen Sie wie ein Anführer und nicht wie ein Hintergrundcharakter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites 10 pas complets dans n'importe quelle pièce ou rue avec votre téléphone dans votre poche, les épaules en arrière et les yeux levés, en scannant comme un leader et non comme un personnage d'arrière-plan."
          }
        }
      }
    },
    "quest.status-050": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook or plate one meal at home as if you were serving a guest: real plate, real cup, clean table, and sit down to eat it properly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina o emplata una comida en casa como si estuvieras sirviendo a un invitado: plato real, taza real, mesa limpia, y siéntate a comerla apropiadamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kochen oder servieren Sie eine Mahlzeit zu Hause, als würden Sie einen Gast bedienen: echter Teller, echte Tasse, sauberer Tisch, und setz sich hin, um es richtig zu essen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisinez ou préparez un repas à la maison comme si vous serviez un invité : une vraie assiette, une vraie tasse, une table propre et asseyez-vous pour le manger correctement."
          }
        }
      }
    },
    "quest.status-051": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a 20-minute cleaning sprint focused only on what a guest would see if they walked in right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un sprint de limpieza de 20 minutos enfocándote solo en lo que un invitado vería si entrara ahora mismo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen 20-minütigen Reinigungssprint und konzentriere sich nur auf das, was ein Gast sehen würde, wenn er jetzt hereinkäme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un sprint de nettoyage de 20 minutes axé uniquement sur ce qu'un invité verrait s'il entrait maintenant."
          }
        }
      }
    },
    "quest.status-052": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 15 minutes on your walk practicing a slower, smoother pace instead of rushing everywhere like you're behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 15 minutos en tu caminata practicando un ritmo más lento y suave en lugar de apresurarte a todos lados como si fueras tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 15 Minuten auf Ihrem Spaziergang und übe ein langsameres, gleichmäßigeres Tempo, anstatt überall hin zu hetzen, als wären Sie im Rückstand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 15 minutes sur votre marche à pratiquer un rythme plus lent et plus fluide au lieu de vous précipiter partout comme si vous étiez en retard."
          }
        }
      }
    },
    "quest.status-053": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a bookstore, design store, or gallery and spend at least 20 minutes looking at things that feel like your upgraded lifestyle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una librería, tienda de diseño o galería y pasa al menos 20 minutos viendo cosas que se sientan como tu estilo de vida mejorado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in eine Buchhandlung, ein Designgeschäft oder eine Galerie und verbringe mindestens 20 Minuten damit, sich Dinge anzusehen, die sich wie Ihr aufgewerteter Lebensstil anfühlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans une librairie, un magasin de design ou une galerie et passez au moins 20 minutes à regarder des choses qui ressemblent à votre style de vie amélioré."
          }
        }
      }
    },
    "quest.status-054": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a simple, minimal everyday look for your phone case and lockscreen so your tech doesn't look chaotic when you pull it out in public."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un look simple y minimalista para tu funda de teléfono y pantalla de bloqueo para que tu tecnología no se vea caótica cuando la saques en público."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen einfachen, minimalistischen Alltagslook für Ihre Handyhülle und Ihren Sperrbildschirm, damit Ihr Gerät nicht chaotisch aussieht, wenn Sie es in der Öffentlichkeit hervorholen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un look simple et minimal au quotidien pour votre coque de téléphone et votre écran de verrouillage afin que votre technologie n'ait pas l'air chaotique lorsque vous la sortez en public."
          }
        }
      }
    },
    "quest.status-055": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least once this week, arrive 10 minutes early to something on purpose and use the time to calmly observe instead of scrolling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos una vez esta semana, llega 10 minutos temprano a algo a propósito y usa el tiempo para observar calmadamente en lugar de deslizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommen Sie mindestens einmal in dieser Woche bewusst 10 Minuten früher zu etwas und nutze die Zeit zum ruhigen Beobachten, statt zu scrollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une fois cette semaine, arrivez volontairement 10 minutes plus tôt à quelque chose et utilisez ce temps pour observer calmement au lieu de défiler."
          }
        }
      }
    },
    "quest.status-056": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your banking or money app, look at the numbers without flinching, and write down one tiny habit that would move you toward your future lifestyle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tu app bancaria o de dinero, mira los números sin inmutarte, y escribe un pequeño hábito que te acercaría a tu estilo de vida futuro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Ihre Banking- oder Geld-App, schau sich die Zahlen an, ohne mit der Wimper zu zucken, und schreib eine kleine Angewohnheit auf, die Sie zu Ihrem zukünftigen Lebensstil führen würde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez votre application bancaire ou financière, regardez les chiffres sans broncher et notez une petite habitude qui vous guiderait vers votre futur style de vie."
          }
        }
      }
    },
    "quest.status-057": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to an art museum, gallery, or mural district and stand in front of at least 3 pieces as if you're collecting inspiration for your future house."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un museo de arte, galería o distrito de murales y párate frente a al menos 3 piezas como si estuvieras recolectando inspiración para tu futura casa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in ein Kunstmuseum, eine Galerie oder einen Wandgemäldebezirk und stell sich vor mindestens drei Stücke, als ob Sie Inspiration für Ihr zukünftiges Haus sammeln würden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez-vous dans un musée d'art, une galerie ou un quartier de peintures murales et placez-vous devant au moins 3 œuvres comme si vous cherchiez l'inspiration pour votre future maison."
          }
        }
      }
    },
    "quest.status-058": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy or set up one candle, room spray, or incense that makes your space smell like somewhere you'd be proud to invite people into."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra o coloca una vela, spray de ambiente o incienso que haga que tu espacio huela a un lugar donde estarías orgulloso de invitar gente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufen oder stell eine Kerze, ein Raumspray oder ein Räucherstäbchen auf, das Ihren Raum wie einen Ort duften lässt, zu dem Sie gerne Menschen einladen würden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achetez ou installez une bougie, un spray d'ambiance ou de l'encens qui donneront à votre espace l'odeur d'un endroit où vous seriez fier d'inviter des gens."
          }
        }
      }
    },
    "quest.status-059": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes refining your grooming kit: group items, toss what you don't use, and prepare a small travel-ready version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 10 minutos a refinar tu kit de arreglo personal: agrupa artículos, tira lo que no usas, y prepara una versión pequeña lista para viajar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 10 Minuten damit, Ihr Pflegeset zu verfeinern: Gruppieren Sie die Gegenstände, wirf weg, was Sie nicht verwenden, und bereite eine kleine reisefertige Version vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 10 minutes à peaufiner votre kit de soins : regroupez les articles, jetez ce que vous n'utilisez pas et préparez une petite version prête à voyager."
          }
        }
      }
    },
    "quest.status-060": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into a room and consciously choose a spot to stand or sit where you have a good view and aren't hiding in a corner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra a un cuarto y elige conscientemente un lugar para pararte o sentarte donde tengas buena vista y no estés escondido en una esquina."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in einen Raum und wähle bewusst einen Platz zum Stehen oder Sitzen, von dem aus Sie eine gute Sicht haben und der sich nicht in einer Ecke versteckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez dans une pièce et choisissez consciemment un endroit où vous tenir debout ou vous asseoir là où vous avez une bonne vue et où vous ne vous cachez pas dans un coin."
          }
        }
      }
    },
    "quest.status-061": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade one tiny detail people see often such as your keychain, phone wallpaper, or headphones so it feels more intentional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora un pequeño detalle que la gente ve seguido como tu llavero, fondo de pantalla o audífonos para que se sienta más intencional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werten Sie ein kleines Detail auf, das Menschen oft sehen, etwa Ihren Schlüsselbund, das Hintergrundbild Ihres Telefons oder Ihre Kopfhörer, damit es bewusster wirkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez un petit détail que les gens voient souvent, comme votre porte-clés, le fond d'écran de votre téléphone ou vos écouteurs, pour que cela semble plus intentionnel."
          }
        }
      }
    },
    "quest.status-062": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a coffee shop early in the morning before work or obligations and sit there like someone who has important places to be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita una cafetería temprano en la mañana antes del trabajo u obligaciones y siéntate ahí como alguien que tiene lugares importantes donde estar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuch frühmorgens vor der Arbeit oder Ihren Verpflichtungen ein Café und sitz dort wie jemand, der wichtige Orte zu erledigen hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitez un café tôt le matin avant le travail ou vos obligations et asseyez-vous là comme quelqu'un qui a des endroits importants à visiter."
          }
        }
      }
    },
    "quest.status-063": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 20 minutes reviewing and deleting embarrassing or low-status posts, bios, or old content from your social profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 20 minutos a revisar y eliminar publicaciones, biografías o contenido viejo vergonzoso o de bajo estatus de tus perfiles sociales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 20 Minuten damit, peinliche Beiträge, Biografien oder alte Inhalte mit niedrigem Status zu überprüfen und aus Ihren sozialen Profilen zu löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 20 minutes à examiner et à supprimer les publications, biographies ou anciens contenus embarrassants ou de faible statut de vos profils sociaux."
          }
        }
      }
    },
    "quest.status-064": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straighten one wall in your room: fix crooked posters, remove random tape, or hang one thing intentionally centered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arregla una pared en tu cuarto: endereza posters torcidos, quita cinta aleatoria, o cuelga algo intencionalmente centrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie eine Wand in Ihrem Zimmer gerade aus: Bring schiefe Poster an, entferne Klebeband oder hängen Sie etwas absichtlich mittig auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redressez un mur de votre pièce : réparez les affiches tordues, retirez le ruban adhésif au hasard ou accrochez un objet intentionnellement centré."
          }
        }
      }
    },
    "quest.status-065": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a simple, clean outfit and wear it with zero apologies, even if you usually overdress or underdress to blend in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un atuendo simple y limpio y úsalo sin disculpas, incluso si usualmente te vistes de más o de menos para pasar desapercibido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein schlichtes, schlichtes Outfit und trage es ohne Umschweife, auch wenn Sie sich normalerweise zu viel oder zu wenig anziehen, um unauffällig zu sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une tenue simple et propre et portez-la sans aucune excuse, même si vous avez l'habitude de vous habiller trop ou pas assez pour vous fondre dans la masse."
          }
        }
      }
    },
    "quest.status-066": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a 15-minute ab and core session so you feel physically more solid in your torso the next time you're standing around people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una sesión de abdominales y core de 15 minutos para sentirte físicamente más sólido en tu torso la próxima vez que estés parado entre gente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eine 15-minütige Bauch- und Rumpfübung, damit Sie sich körperlich fester in Ihrem Oberkörper fühlen, wenn Sie das nächste Mal in der Nähe von Menschen stehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une séance d'abdominaux et de base de 15 minutes pour vous sentir physiquement plus solide dans votre torse la prochaine fois que vous serez entouré de gens."
          }
        }
      }
    },
    "quest.status-067": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit at the bar or main counter of a place and have a short, respectful interaction with staff as if you're a familiar regular."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la barra o mostrador principal de un lugar y ten una interacción corta y respetuosa con el personal como si fueras un cliente habitual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich an die Bar oder den Hauptschalter eines Lokals und unterhalten Sie sich kurz und respektvoll mit dem Personal, als ob Sie ein vertrauter Stammgast wären."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous au bar ou au comptoir principal d'un lieu et ayez une interaction brève et respectueuse avec le personnel comme si vous étiez un habitué."
          }
        }
      }
    },
    "quest.status-068": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes practicing a calm, neutral facial expression in the mirror that looks confident, not angry or anxious, then wear it on your next outing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 10 minutos practicando una expresión facial calmada y neutral en el espejo que se vea confiada, no enojada o ansiosa, luego úsala en tu próxima salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 10 Minuten damit, im Spiegel einen ruhigen, neutralen Gesichtsausdruck zu üben, der selbstbewusst, nicht wütend oder ängstlich wirkt, und trage ihn dann bei Ihrem nächsten Ausflug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 10 minutes à pratiquer une expression faciale calme et neutre dans le miroir qui semble confiante, ni en colère ni anxieuse, puis portez-la lors de votre prochaine sortie."
          }
        }
      }
    },
    "quest.status-069": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorganize your main workspace so there's one clean area large enough to write, draw, or use your laptop without shifting stuff around first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorganiza tu espacio de trabajo principal para que haya un área limpia suficientemente grande para escribir, dibujar o usar tu laptop sin mover cosas primero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisiere Ihren Hauptarbeitsplatz neu, sodass ein sauberer Bereich vorhanden ist, der groß genug ist, um zu schreiben, zu zeichnen oder Ihren Laptop zu verwenden, ohne vorher Dinge umzuräumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganisez votre espace de travail principal afin qu'il y ait une zone propre suffisamment grande pour écrire, dessiner ou utiliser votre ordinateur portable sans déplacer d'abord des objets."
          }
        }
      }
    },
    "quest.status-070": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a rooftop bar, balcony, or top floor of a parking structure at night and stand there for 5 minutes imagining the life you're building."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un bar en azotea, balcón o piso superior de un estacionamiento de noche y párate ahí por 5 minutos imaginando la vida que estás construyendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh nachts auf eine Bar auf dem Dach, auf einen Balkon oder in die oberste Etage eines Parkhauses und steh dort fünf Minuten lang und stell sich das Leben vor, das Sie aufbauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans un bar sur le toit, sur un balcon ou au dernier étage d'un parking la nuit et restez là pendant 5 minutes en imaginant la vie que vous construisez."
          }
        }
      }
    },
    "quest.status-071": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one fully intentional selfie or timer photo in a nice environment where you look like the higher-status version of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate una selfie o foto con temporizador completamente intencional en un ambiente bonito donde te veas como la versión de mayor estatus de ti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ganz bewusst ein Selfie oder ein Timer-Foto in einer schönen Umgebung, in der Sie wie die höherrangige Version von Ihnen aussehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un selfie ou une photo avec retardateur entièrement intentionnel dans un environnement agréable où vous ressemblez à la version de statut supérieur de vous-même."
          }
        }
      }
    },
    "quest.status-072": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 15 minutes standing or walking with your hands out of your pockets, shoulders relaxed, and chest open in a public area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 15 minutos parado o caminando con las manos fuera de tus bolsillos, hombros relajados y pecho abierto en un área pública."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe 15 Minuten im Stehen oder Gehen mit den Händen aus den Taschen, entspannten Schultern und geöffneter Brust in einem öffentlichen Bereich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez 15 minutes debout ou marchant avec les mains hors des poches, les épaules détendues et la poitrine ouverte dans un espace public."
          }
        }
      }
    },
    "quest.status-073": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy one inexpensive but elevated snack or drink (sparkling water, nicer chocolate, etc.) and eat or drink it slowly in a clean space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra un snack o bebida económico pero elevado (agua con gas, mejor chocolate, etc.) y cómelo o bébelo lentamente en un espacio limpio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf einen preiswerten, aber hochwertigen Snack oder ein Getränk (Sprudelwasser, bessere Schokolade usw.) und essen oder trinken Sie es langsam an einem sauberen Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achetez une collation ou une boisson bon marché mais raffinée (eau gazeuse, chocolat plus agréable, etc.) et mangez-la ou buvez-la lentement dans un espace propre."
          }
        }
      }
    },
    "quest.status-074": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset your bed area: straighten sheets, adjust pillows, and remove random clutter from around where you sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia tu área de cama: endereza sábanas, ajusta almohadas, y quita el desorden aleatorio de alrededor de donde duermes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalten Sie Ihren Schlafbereich neu: Richten Sie die Laken gerade aus, passe die Kissen an und beseitigen Sie Unordnung in der Umgebung Ihres Schlafplatzes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialisez votre zone de lit : redressez les draps, ajustez les oreillers et supprimez l'encombrement aléatoire autour de l'endroit où vous dormez."
          }
        }
      }
    },
    "quest.status-075": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a bank, credit union, or fintech app and make sure your main account situation is at least clear and intentional, not random and scattered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un banco, cooperativa de crédito o app fintech y asegúrate de que tu situación de cuenta principal sea al menos clara e intencional, no aleatoria y dispersa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Bank, eine Kreditgenossenschaft oder eine Fintech-App aus und stell sicher, dass die Situation Ihres Hauptkontos zumindest klar und absichtlich und nicht zufällig und verstreut ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une banque, une coopérative de crédit ou une application fintech et assurez-vous que la situation de votre compte principal est au moins claire et intentionnelle, et non aléatoire et dispersée."
          }
        }
      }
    },
    "quest.status-076": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into a lobby, mall, or plaza and take the stairs instead of escalator or elevator while holding good posture the whole way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra a un lobby, centro comercial o plaza y toma las escaleras en lugar del elevador o escalera eléctrica mientras mantienes buena postura todo el camino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in eine Lobby, ein Einkaufszentrum oder einen Platz und nimm die Treppe statt der Rolltreppe oder des Aufzugs und behalten Sie dabei eine gute Körperhaltung bei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez dans un hall, un centre commercial ou une place et prenez les escaliers au lieu de l'escalier roulant ou de l'ascenseur tout en gardant une bonne posture tout au long du trajet."
          }
        }
      }
    },
    "quest.status-077": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to a coffee shop with your laptop or notebook and spend 20 minutes planning one future life upgrade such as moving, wardrobe, or career."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a una cafetería con tu laptop o cuaderno y pasa 20 minutos planeando una mejora de vida futura como mudarte, guardarropa o carrera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh mit Ihrem Laptop oder Notebook in ein Café und verbringe 20 Minuten damit, eine zukünftige Verbesserung Ihres Lebens zu planen, z. B. einen Umzug, eine Garderobe oder eine Karriere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans un café avec votre ordinateur portable ou votre ordinateur portable et passez 20 minutes à planifier une évolution future de votre vie, comme un déménagement, une garde-robe ou une carrière."
          }
        }
      }
    },
    "quest.status-078": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one jacket, hoodie, or coat and lint-roll, patch, or clean it so it always looks presentable in public."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una chaqueta, sudadera o abrigo y quítale pelusa, parchea o límpialo para que siempre se vea presentable en público."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Jacke, einen Kapuzenpullover oder einen Mantel aus und fusseln Sie sie, flicken Sie sie oder reinige sie, damit sie in der Öffentlichkeit immer vorzeigbar aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une veste, un sweat à capuche ou un manteau et appliquez un rouleau anti-peluches, appliquez un patch ou nettoyez-le pour qu'il soit toujours présentable en public."
          }
        }
      }
    },
    "quest.status-079": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend one event, bar, or spot slightly above your usual comfort level in terms of vibe or dress code and stay at least 30 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiste a un evento, bar o lugar ligeramente por encima de tu nivel de comodidad usual en términos de ambiente o código de vestimenta y quédate al menos 30 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuch eine Veranstaltung, eine Bar oder einen Ort, der in Bezug auf Atmosphäre oder Kleiderordnung etwas über Ihrem üblichen Komfortniveau liegt, und bleib mindestens 30 Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistez à un événement, un bar ou un lieu légèrement au-dessus de votre niveau de confort habituel en termes d'ambiance ou de code vestimentaire et restez au moins 30 minutes."
          }
        }
      }
    },
    "quest.status-080": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your alarm and wake up one hour earlier than usual once this week, using that time to shower, dress well, and move slowly but intentionally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu alarma y despierta una hora más temprano de lo usual una vez esta semana, usando ese tiempo para bañarte, vestirte bien y moverte lento pero intencionalmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell Ihren Wecker und steh diese Woche einmal eine Stunde früher als gewöhnlich auf. Nutze diese Zeit zum Duschen, kleiden Sie sich gut und bewege sich langsam, aber bewusst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez votre réveil et réveillez-vous une heure plus tôt que d'habitude une fois cette semaine, profitant de ce temps pour vous doucher, bien vous habiller et bouger lentement mais intentionnellement."
          }
        }
      }
    },
    "quest.status-081": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go for a 30-minute walk in a nicer neighborhood while listening to a podcast or audio that upgrades your mindset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un paseo de 30 minutos en un vecindario más bonito mientras escuchas un podcast o audio que mejore tu mentalidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen 30-minütigen Spaziergang in einer schöneren Gegend und hör sich dabei einen Podcast oder eine Audioaufnahme an, die Ihre Denkweise verbessert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partez pour une promenade de 30 minutes dans un quartier plus agréable tout en écoutant un podcast ou un audio qui améliore votre état d'esprit."
          }
        }
      }
    },
    "quest.status-082": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean your kitchen sink area so it doesn't look embarrassing if someone sees it: no crusty plates, no overflowing trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia el área de tu fregadero de cocina para que no se vea vergonzoso si alguien lo ve: nada de platos con mugre, nada de basura desbordándose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinige Ihren Spülbeckenbereich, damit er nicht peinlich aussieht, wenn jemand ihn sieht: keine verkrusteten Teller, kein überlaufender Müll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez l'évier de votre cuisine pour qu'il ne soit pas gênant si quelqu'un le voit : pas d'assiettes croustillantes, pas de déchets qui débordent."
          }
        }
      }
    },
    "quest.status-083": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a local store that sells home goods and pick out one item, even just mentally, that you'd buy for your future higher-status apartment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita una tienda local que venda artículos para el hogar y elige un artículo, aunque sea mentalmente, que comprarías para tu futuro departamento de mayor estatus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuch ein lokales Geschäft, das Haushaltswaren verkauft, und wähle, auch nur im Geiste, einen Artikel aus, den Sie für Ihre zukünftige, höherwertige Wohnung kaufen würden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitez un magasin local qui vend des articles pour la maison et choisissez un article, même mentalement, que vous achèteriez pour votre futur appartement de statut supérieur."
          }
        }
      }
    },
    "quest.status-084": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear a watch, bracelet, or necklace intentionally for one full day to see how it changes how you carry yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un reloj, pulsera o collar intencionalmente por un día completo para ver cómo cambia tu forma de desenvolverte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage absichtlich einen ganzen Tag lang eine Uhr, ein Armband oder eine Halskette, um zu sehen, wie sich dadurch Ihre Haltung verändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez intentionnellement une montre, un bracelet ou un collier pendant une journée complète pour voir comment cela change votre façon de vous comporter."
          }
        }
      }
    },
    "quest.status-085": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit somewhere busy like a mall or café and do not touch your phone for 10 minutes, just observing like someone who's comfortable being seen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en algún lugar concurrido como un centro comercial o café y no toques tu teléfono por 10 minutos, solo observando como alguien que está cómodo siendo visto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich an einen belebten Ort, beispielsweise in ein Einkaufszentrum oder ein Café, und berühre Ihr Telefon 10 Minuten lang nicht, sondern beobachte einfach wie jemand, der sich gerne gesehen fühlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous dans un endroit fréquenté comme un centre commercial ou un café et ne touchez pas votre téléphone pendant 10 minutes, observez simplement comme quelqu'un qui se sent à l'aise d'être vu."
          }
        }
      }
    },
    "quest.status-086": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a different, more scenic route home at least once this week and stop to take a photo where you feel like the main character of the city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una ruta diferente y más pintoresca a casa al menos una vez esta semana y detente a tomar una foto donde te sientas como el personaje principal de la ciudad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm diese Woche mindestens einmal einen anderen, malerischeren Weg nach Hause und halte an, um ein Foto zu machen, auf dem Sie sich wie die Hauptfigur der Stadt fühlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empruntez un itinéraire différent et plus pittoresque pour rentrer chez vous au moins une fois cette semaine et arrêtez-vous pour prendre une photo où vous vous sentez comme le personnage principal de la ville."
          }
        }
      }
    },
    "quest.status-087": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a 20-minute full-body stretch session before going out one evening so you feel looser and more comfortable in your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una sesión de estiramiento de cuerpo completo de 20 minutos antes de salir una noche para sentirte más suelto y cómodo en tu cuerpo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eines Abends vor dem Ausgehen eine 20-minütige Ganzkörper-Stretch-Sitzung, damit Sie sich lockerer und wohler in Ihrem Körper fühlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
