        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie Ihr Ladegerät dort, wo es Sie nicht dazu verleitet, im Bett weiter zu scrollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez votre chargeur là où il ne vous tentera pas de continuer à défiler au lit."
          }
        }
      }
    },
    "quest.everyday-215": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your sleeping area 5% better by adjusting one thing: light, temperature, blanket, pillow, or noise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que tu espacio para dormir sea 5% mejor ajustando una sola cosa: luz, temperatura, manta, almohada o ruido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessere Ihren Schlafbereich um 5 %, indem Sie eine Sache anpassen: Licht, Temperatur, Decke, Kissen oder Lärm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez votre espace de couchage de 5 % en ajustant une chose : la lumière, la température, la couverture, l'oreiller ou le bruit."
          }
        }
      }
    },
    "quest.everyday-216": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the space directly around your bed so nothing feels chaotic when you wake up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despeja el espacio justo alrededor de tu cama para que nada se sienta caótico al despertar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume den Raum direkt um Ihr Bett frei, damit sich beim Aufwachen nichts chaotisch anfühlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez l’espace directement autour de votre lit pour que rien ne soit chaotique au réveil."
          }
        }
      }
    },
    "quest.everyday-217": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down the last thing you want to remember from today before you fall asleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de dormirte, escribe la última cosa que quieres recordar de hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib vor dem Einschlafen das Letzte auf, woran Sie sich heute erinnern möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez la dernière chose dont vous voulez vous souvenir aujourd'hui avant de vous endormir."
          }
        }
      }
    },
    "quest.everyday-218": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one no-phone wind-down activity for tonight and do it for 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una actividad para relajarte esta noche sin teléfono y hazla durante 10 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für heute Abend eine Entspannungsaktivität ohne Telefon aus und mach sie 10 Minuten lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une activité de détente sans téléphone pour ce soir et faites-la pendant 10 minutes."
          }
        }
      }
    },
    "quest.everyday-219": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that your alarm volume, charge level, and wake time are all correct before bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de acostarte, verifica que el volumen de la alarma, la carga y la hora de despertar estén correctos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor dem Schlafengehen, ob die Alarmlautstärke, der Ladezustand und die Weckzeit korrekt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le volume de votre alarme, votre niveau de charge et votre heure de réveil sont tous corrects avant de vous coucher."
          }
        }
      }
    },
    "quest.everyday-220": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a glass or bottle of water beside your bed for tomorrow morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja un vaso o botella de agua al lado de tu cama para mañana por la mañana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell für morgen früh ein Glas oder eine Flasche Wasser neben Ihr Bett."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un verre ou une bouteille d'eau à côté de votre lit pour demain matin."
          }
        }
      }
    },
    "quest.everyday-221": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash produce or prep one ingredient now so a future meal takes less effort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava fruta o prepara ahora un ingrediente para que una comida futura requiera menos esfuerzo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasche die Produkte jetzt oder bereite eine Zutat vor, damit eine zukünftige Mahlzeit weniger Aufwand erfordert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavez les produits ou préparez un ingrédient maintenant pour qu’un prochain repas demande moins d’effort."
          }
        }
      }
    },
    "quest.everyday-222": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boil eggs, rice, or another simple staple to make tomorrow easier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierve huevos, arroz u otro básico simple para que mañana sea más fácil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koch Eier, Reis oder ein anderes einfaches Grundnahrungsmittel, um den Morgen einfacher zu machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites bouillir des œufs, du riz ou un autre aliment de base simple pour faciliter demain."
          }
        }
      }
    },
    "quest.everyday-223": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean as you cook during one meal instead of leaving the whole mess for later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia mientras cocinas durante una comida en lugar de dejar todo el desastre para después."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinige, während Sie während einer Mahlzeit kochen, anstatt die ganze Sauerei für später aufzubewahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez pendant que vous cuisinez pendant un repas au lieu de laisser tout le désordre pour plus tard."
          }
        }
      }
    },
    "quest.everyday-224": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one ingredient already in your kitchen that has been sitting untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un ingrediente que ya está en tu cocina y lleva tiempo sin tocarse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine Zutat, die sich bereits in Ihrer Küche befindet und unberührt geblieben ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un ingrédient déjà présent dans votre cuisine et qui n’a pas été touché."
          }
        }
      }
    },
    "quest.everyday-225": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one sauce, dressing, or seasoning mix yourself instead of using it straight from the bottle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz tú mismo/a una salsa, aderezo o mezcla de condimentos en vez de usarla directo de la botella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eine Soße, ein Dressing oder eine Gewürzmischung selbst, anstatt sie direkt aus der Flasche zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez vous-même une sauce, une vinaigrette ou un mélange d'assaisonnement au lieu de l'utiliser directement de la bouteille."
          }
        }
      }
    },
    "quest.everyday-226": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portion leftovers into a container you will actually want to reheat later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las sobras en un recipiente que de verdad quieras recalentar más tarde."
          }
